@page
@model HospitalWebApp.Pages.Queue.IndexModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.QueueType) ? "Patient Queues" : $"{Model.QueueType} Queue";
}

<div class="dashboard-shell"><div class="container">
    <div class="dashboard-header">
        <div>
            <div class="dashboard-kicker">Live care workflow</div>
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">Review and manage queued patients across hospital workflows.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="btn-group">
                <a asp-area="" asp-page="/Queue/Index" class="btn btn-outline-secondary btn-sm">All</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Doctor" class="btn btn-outline-primary btn-sm">Doctor</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Triage" class="btn btn-outline-success btn-sm">Triage</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Lab" class="btn btn-outline-warning btn-sm">Lab</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Pharmacy" class="btn btn-outline-info btn-sm">Pharmacy</a>
            </div>
        }
        else if (User.IsInRole("Nurse"))
        {
            <div class="btn-group">
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Doctor" class="btn btn-outline-primary btn-sm">Doctor</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Triage" class="btn btn-outline-success btn-sm">Triage</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Lab" class="btn btn-outline-warning btn-sm">Lab</a>
                <a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Pharmacy" class="btn btn-outline-info btn-sm">Pharmacy</a>
            </div>
        }
    </div>

    <div class="dashboard-panel"><div class="table-responsive"><table class="dashboard-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Queue Type</th>
                <th>Patient</th>
                <th>Assigned By</th>
                <th>Status</th>
                <th>Created</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.QueueEntries)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.QueueType</td>
                    <td>@item.Patient?.FullName ?? item.PatientId</td>
                    <td>@item.AssignedBy?.FullName ?? item.AssignedById</td>
                    <td>@item.Status</td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.Notes</td>
                </tr>
            }
        </tbody>
    </table></div></div>
</div></div>
