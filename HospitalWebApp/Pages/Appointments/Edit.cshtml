@page
@model HospitalWebApp.Pages_Appointments.EditModel
@{
    ViewData["Title"] = "Edit appointment";
}

<div class="dashboard-shell"><div class="container" style="max-width:900px">
    <div class="dashboard-header"><div><div class="dashboard-kicker">Care schedule</div><h1>Edit appointment</h1><p>Update scheduling details while preserving billing and clinical records.</p></div><a asp-area="" asp-page="/Appointments/Index" class="btn btn-outline-primary">Back to appointments</a></div>
    <div class="dashboard-panel dashboard-panel-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Appointment.Id" />
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="Appointment.PatientId" class="form-label">Patient</label><select asp-for="Appointment.PatientId" class="form-select" asp-items="ViewBag.PatientId"></select></div>
                <div class="col-md-6"><label asp-for="Appointment.DoctorId" class="form-label">Doctor</label><select asp-for="Appointment.DoctorId" class="form-select" asp-items="ViewBag.DoctorId"></select></div>
                <div class="col-md-6"><label asp-for="Appointment.AppointmentDate" class="form-label">Date and time</label><input asp-for="Appointment.AppointmentDate" class="form-control" /><span asp-validation-for="Appointment.AppointmentDate" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Appointment.Status" class="form-label">Status</label><select asp-for="Appointment.Status" class="form-select"><option>Pending</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option></select></div>
                <div class="col-12"><label asp-for="Appointment.SymptomsSummary" class="form-label">Reason for visit</label><textarea asp-for="Appointment.SymptomsSummary" class="form-control" rows="4"></textarea></div>
                <div class="col-12 form-check ms-2"><input asp-for="Appointment.IsVirtual" class="form-check-input" /><label asp-for="Appointment.IsVirtual" class="form-check-label">Virtual consultation</label></div>
            </div>
            <div class="d-flex justify-content-end mt-4"><button type="submit" class="btn btn-primary">Save appointment</button></div>
        </form>
    </div>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
