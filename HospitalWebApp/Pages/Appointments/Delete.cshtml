@page
@model HospitalWebApp.Pages_Appointments.DeleteModel
@{
    ViewData["Title"] = "Cancel appointment";
}

<div class="dashboard-shell"><div class="container" style="max-width:760px">
    <div class="dashboard-header"><div><div class="dashboard-kicker">Care schedule</div><h1>Cancel appointment</h1><p>The record will be kept for care and billing history, with its status changed to Cancelled.</p></div></div>
    <div class="dashboard-panel dashboard-panel-body">
        <dl class="row">
            <dt class="col-sm-4">Patient</dt><dd class="col-sm-8">@Model.Appointment.Patient?.FullName</dd>
            <dt class="col-sm-4">Clinician</dt><dd class="col-sm-8">@Model.Appointment.Doctor?.FullName</dd>
            <dt class="col-sm-4">Date and time</dt><dd class="col-sm-8">@Model.Appointment.AppointmentDate.ToString("dddd, MMM d, yyyy h:mm tt")</dd>
            <dt class="col-sm-4">Current status</dt><dd class="col-sm-8">@Model.Appointment.Status</dd>
        </dl>
        <form method="post" class="d-flex justify-content-end gap-2">
            <input type="hidden" name="id" value="@Model.Appointment.Id" />
            <a asp-area="" asp-page="/Appointments/Index" class="btn btn-outline-secondary">Keep appointment</a>
            <button type="submit" class="btn btn-danger">Cancel appointment</button>
        </form>
    </div>
</div></div>
