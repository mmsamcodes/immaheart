@page
@model HospitalWebApp.Pages_Appointments.DetailsModel
@{
    ViewData["Title"] = "Appointment details";
}

<div class="dashboard-shell"><div class="container">
    <div class="dashboard-header"><div><div class="dashboard-kicker">Care schedule</div><h1>Appointment details</h1><p>Review appointment information and status.</p></div><a asp-area="" asp-page="/Appointments/Index" class="btn btn-outline-primary">Back to appointments</a></div>
    <div class="dashboard-panel dashboard-panel-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@Model.Appointment.Patient?.FullName</dd>
            <dt class="col-sm-3">Clinician</dt><dd class="col-sm-9">@Model.Appointment.Doctor?.FullName</dd>
            <dt class="col-sm-3">Date and time</dt><dd class="col-sm-9">@Model.Appointment.AppointmentDate.ToString("dddd, MMM d, yyyy h:mm tt")</dd>
            <dt class="col-sm-3">Visit type</dt><dd class="col-sm-9">@(Model.Appointment.IsVirtual ? "Virtual" : "In person")</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Appointment.Status</dd>
            <dt class="col-sm-3">Reason for visit</dt><dd class="col-sm-9">@Model.Appointment.SymptomsSummary</dd>
        </dl>
        @if (User.IsInRole("Admin") || User.IsInRole("Reception"))
        {
            <a asp-area="" asp-page="/Appointments/Edit" asp-route-id="@Model.Appointment.Id" class="btn btn-primary mt-3">Edit appointment</a>
        }
    </div>
</div></div>
