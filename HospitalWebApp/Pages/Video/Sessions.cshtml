@page
@model HospitalWebApp.Pages.Video.SessionsModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@{
    ViewData["Title"] = "Video Sessions";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">Virtual Appointments</h2>
            <p class="text-muted">Create, confirm and join telehealth sessions for patients who already have payment confirmed.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.VideoSessions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Session</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.VideoSessions)
                            {
                                <tr id="appointment-row-@appointment.Id">
                                    <td>@(appointment.Patient?.FullName ?? "Unknown")</td>
                                    <td>@(appointment.Doctor?.FullName ?? "Unknown")</td>
                                    <td>@appointment.AppointmentDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(appointment.VideoJoinUrl))
                                        {
                                            <span class="badge bg-success">Ready</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Not created</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(appointment.VideoJoinUrl))
                                        {
                                            <a href="@appointment.VideoJoinUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">Join session</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No join URL yet</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="createSession(@appointment.Id)">Create session</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No video appointments have been scheduled yet. Confirm payment and return when the appointment is ready to be connected.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function createSession(appointmentId) {
            const button = document.querySelector(`#appointment-row-${appointmentId} button`);
            if (!button) return;
            button.disabled = true;
            button.textContent = 'Creating...';

            try {
                const response = await fetch(`/api/video/create-session/${appointmentId}`, { method: 'POST' });
                if (!response.ok) {
                    throw new Error('Unable to create session');
                }

                const data = await response.json();
                const row = document.getElementById(`appointment-row-${appointmentId}`);
                const statusCell = row.querySelector('td:nth-child(4)');
                const sessionCell = row.querySelector('td:nth-child(5)');

                statusCell.innerHTML = '<span class="badge bg-success">Ready</span>';
                sessionCell.innerHTML = `<a href="${data.joinUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">Join session</a>`;
                button.textContent = 'Created';
                button.disabled = true;
            } catch (error) {
                button.textContent = 'Failed';
                console.error(error);
                setTimeout(() => {
                    button.textContent = 'Create session';
                    button.disabled = false;
                }, 1500);
            }
        }
    </script>
}
