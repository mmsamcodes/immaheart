@page
@model HospitalWebApp.Pages_Admissions.IndexModel
@{
    ViewData["Title"] = "Admissions";
}

<div class="dashboard-shell"><div class="container">
<div class="dashboard-header"><div><div class="dashboard-kicker">Inpatient care</div><h1>Patient Admissions</h1><p>Monitor wards, beds and admission status.</p></div></div>
<div class="dashboard-panel"><div class="table-responsive"><table class="dashboard-table">
    <thead>
        <tr>
            <th>Admission</th>
            <th>Patient</th>
            <th>Ward / Bed</th>
            <th>Status</th>
            <th>Admitted</th>
            <th>Discharge</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var admission in Model.Admissions)
        {
            <tr>
                <td>@admission.Id</td>
                <td>@admission.Patient?.FullName ?? admission.PatientId</td>
                <td>@admission.Ward - @admission.Bed</td>
                <td>@admission.Status</td>
                <td>@admission.AdmissionDate.ToString("yyyy-MM-dd")</td>
                <td>@(admission.DischargeDate.HasValue ? admission.DischargeDate.Value.ToString("yyyy-MM-dd") : "—")</td>
            </tr>
        }
    </tbody>
</table></div></div>
</div></div>
