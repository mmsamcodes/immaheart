@page
@model HospitalWebApp.Pages_Billing.IndexModel
@{
    ViewData["Title"] = "Billing";
}

<h1 class="mb-4">Billing Invoices</h1>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Invoice</th>
            <th>Patient</th>
            <th>Total</th>
            <th>Paid</th>
            <th>Status</th>
            <th>Issued</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model.Invoices)
        {
            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@invoice.Patient?.FullName ?? invoice.PatientId</td>
                <td>@invoice.TotalAmount.ToString("C")</td>
                <td>@invoice.PaidAmount.ToString("C")</td>
                <td>@invoice.Status</td>
                <td>@invoice.IssuedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-page="/Billing/Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
