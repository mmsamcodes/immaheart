@page
@model HospitalWebApp.Pages_Billing.IndexModel
@{
    ViewData["Title"] = "Billing";
}

<div class="dashboard-shell"><div class="container">
<div class="dashboard-header"><div><div class="dashboard-kicker">Patient finance</div><h1>Billing Invoices</h1><p>Review invoice totals, payments and current status.</p></div></div>
<div class="dashboard-panel"><div class="table-responsive"><table class="dashboard-table">
    <thead>
        <tr>
            <th>Invoice</th>
            <th>Patient</th>
            <th>Total</th>
            <th>Paid</th>
            <th>Status</th>
            <th>Issued</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model.Invoices)
        {
            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@(User.IsInRole("Patient") ? "My account" : invoice.Patient?.FullName ?? invoice.PatientId)</td>
                <td>KSh @invoice.TotalAmount.ToString("N2")</td>
                <td>KSh @invoice.PaidAmount.ToString("N2")</td>
                <td>@invoice.Status</td>
                <td>@invoice.IssuedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-page="/Billing/Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    @if (invoice.Payments.OrderByDescending(payment => payment.ReceivedAt).FirstOrDefault() is { } latestPayment)
                    {
                        <a asp-page="/Billing/Receipt" asp-route-id="@latestPayment.Id" class="btn btn-sm btn-outline-primary">Receipt</a>
                    }
                    @if (User.IsInRole("Patient") && invoice.PaidAmount < invoice.TotalAmount)
                    {
                        <a asp-page="/Billing/Pay" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-primary">Pay</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table></div></div>
</div></div>
