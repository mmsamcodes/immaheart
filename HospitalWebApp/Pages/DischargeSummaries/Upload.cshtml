@page
@model HospitalWebApp.Pages.DischargeSummaries.UploadModel
@{
    ViewData["Title"] = "Upload Discharge Summary";
}

<div class="container py-5">
    <h1>Upload Discharge Summary</h1>
    <p class="text-muted">Upload a discharge summary document for a registered patient.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="PatientId" class="form-label">Patient</label>
                    <select asp-for="PatientId" asp-items="Model.PatientList" class="form-select"></select>
                    <span asp-validation-for="PatientId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SummaryFile" class="form-label">File</label>
                    <input asp-for="SummaryFile" class="form-control" type="file" />
                    <span asp-validation-for="SummaryFile" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-page="/DischargeSummaries/Index" class="btn btn-secondary ms-2">View summaries</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
