@{
    ViewData["Title"] = "Our Medical Services";
    ViewData["Description"] = "Explore the full range of medical services at Immaculate Heart Hospital Kereita, including emergency, maternity, diagnostics, chronic care, dental, and ambulance transport.";
    ViewData["Keywords"] = "medical services Kereita, hospital services Kenya, emergency care, maternity, diagnostics, ambulance hospital";
    ViewData["OgImage"] = "https://immaculatehearthospitalkereita.org/images/theatre view.JPG";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Level 4 Hospital Clinical Services</h1>
        <p class="lead mb-0">Comprehensive, compassionate care across emergency, inpatient, maternity, and specialty clinics.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <h2 class="text-primary fw-bold mb-3">Right Service, Right Care</h2>
            <p class="text-secondary lead">Our service pages are designed to help patients understand the hospital's core strengths and where to go for the right support.</p>
            <p class="text-muted">Incorporate hospital imagery alongside this content to show your clinical areas, maternity suite, and diagnostic facilities. Visitors respond best when the text is backed by strong facility photos.</p>
        </div>
        <div class="col-lg-5">
            <div class="rounded overflow-hidden shadow-sm services-image">
                <img src="~/images/theatre view.JPG" alt="Hospital clinical services" class="img-fluid" />
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="text-primary fw-bold">Our Clinical Expertise</h2>
            <p class="text-muted mx-auto" style="max-width: 680px;">A broad range of hospital services built for emergencies, planned care, and preventative wellness.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Emergency & Outpatient Services</h4>
                    <p class="text-muted small">24/7 emergency triage, urgent care consultations, stitches, and outpatient clinical reviews for acute and chronic symptoms.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Maternity & Child Health</h4>
                    <p class="text-muted small">Safe delivery care, antenatal monitoring, postnatal follow-up, newborn immunizations, and family-centered obstetric support.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Diagnostics & Lab Work</h4>
                    <p class="text-muted small">Pathology, blood tests, ultrasound imaging, and rapid lab results to help clinicians make effective treatment decisions.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Chronic Disease Clinics</h4>
                    <p class="text-muted small">Structured follow-up clinics for Diabetes, Hypertension, TB, and arthritis ensuring continuity of care.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Ambulance & Emergency Transport</h4>
                    <p class="text-muted small">24/7 ambulance dispatch, emergency patient transfers, and on-call transport for urgent medical needs.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Dental Clinic Services</h4>
                    <p class="text-muted small">Restorative dental work, hygiene services, oral health education, and satellite referrals at the Kimende clinic.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <h4 class="h5 fw-bold text-primary mb-3">Physiotherapy & Rehab</h4>
                    <p class="text-muted small">Guided rehabilitation for injury recovery, movement restoration, and muscle strengthening.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-4">
        <div class="col-md-6">
            <div class="rounded overflow-hidden shadow-sm services-image">
                <img src="~/images/inside.JPG" alt="Hospital service area" class="img-fluid" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 bg-white rounded shadow-sm">
                <h3 class="text-primary fw-bold mb-3">How to Place Hospital Photos</h3>
                <ul class="list-unstyled mb-0 text-muted small">
                    <li class="mb-2"><strong>Hero image:</strong> Use a welcoming hospital exterior or patient care team photo at the top of the page.</li>
                    <li class="mb-2"><strong>Service blocks:</strong> Add relevant staff or treatment images next to each major service group.</li>
                    <li class="mb-2"><strong>Facility gallery:</strong> Show your wards, reception, and emergency department in a dedicated photo strip.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5 bg-primary text-white rounded shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-3">Need help choosing the right clinic?</h2>
            <p class="mb-0">Contact our support team for guidance on which department best fits your health needs.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-warning btn-lg fw-bold">Contact Reception</a>
        </div>
    </div>
</section>
