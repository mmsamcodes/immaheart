@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Immaculate Heart Hospital Kereita offers emergency care, maternity services, diagnostics, and compassionate patient-focused healthcare in Kiambu County, Kenya.";
    ViewData["Keywords"] = "hospital in Kereita, Immaculate Heart Hospital, emergency care, maternity, diagnostics, ambulance, healthcare Kenya";
    ViewData["OgImage"] = "https://immaculatehearthospitalkereita.org/images/compound.JPG";
}

<section class="hospital-hero">
    <div class="hero-shade"></div>
    <div class="container hero-inner">
        <div class="hero-copy">
            <span class="hero-kicker"><i class="fas fa-shield-heart" aria-hidden="true"></i> Level 4 Mission Hospital</span>
            <h1>Trusted care, close to home.</h1>
            <p>Compassionate emergency, maternity, diagnostic and everyday healthcare for Kereita and the wider community.</p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Contact" class="btn hero-primary"><i class="fas fa-calendar-check" aria-hidden="true"></i> Book a visit</a>
                <a href="tel:+254110361550" class="btn hero-emergency"><i class="fas fa-phone-volume" aria-hidden="true"></i> Emergency call</a>
            </div>
            <div class="hero-trust" aria-label="Hospital assurances">
                <span><i class="fas fa-circle-check" aria-hidden="true"></i> 24/7 emergency</span>
                <span><i class="fas fa-circle-check" aria-hidden="true"></i> Qualified clinical team</span>
            </div>
        </div>
    </div>
</section>

<section class="quick-care" aria-label="Quick care options">
    <div class="container">
        <div class="quick-care-grid">
            <a asp-controller="Services" asp-action="EmergencyOutpatient" class="quick-care-card emergency-card">
                <span class="quick-icon"><i class="fas fa-heart-pulse" aria-hidden="true"></i></span>
                <span><small>Urgent help</small><strong>Emergency care</strong></span>
                <i class="fas fa-arrow-right quick-arrow" aria-hidden="true"></i>
            </a>
            <a asp-controller="Home" asp-action="Contact" class="quick-care-card">
                <span class="quick-icon"><i class="fas fa-calendar-days" aria-hidden="true"></i></span>
                <span><small>Plan ahead</small><strong>Appointments</strong></span>
                <i class="fas fa-arrow-right quick-arrow" aria-hidden="true"></i>
            </a>
            <a asp-controller="Services" asp-action="DiagnosticsLab" class="quick-care-card">
                <span class="quick-icon"><i class="fas fa-vials" aria-hidden="true"></i></span>
                <span><small>Fast answers</small><strong>Laboratory</strong></span>
                <i class="fas fa-arrow-right quick-arrow" aria-hidden="true"></i>
            </a>
            <a asp-controller="Services" asp-action="AmbulanceTransport" class="quick-care-card">
                <span class="quick-icon"><i class="fas fa-truck-medical" aria-hidden="true"></i></span>
                <span><small>Rapid response</small><strong>Ambulance</strong></span>
                <i class="fas fa-arrow-right quick-arrow" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

<section class="care-services section-pad">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="section-kicker">Our specialties</span>
                <h2>Care for every stage of life</h2>
            </div>
            <a asp-controller="Home" asp-action="Services" class="text-link">View all services <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="service-grid">
            <a asp-controller="Services" asp-action="EmergencyOutpatient" class="care-card">
                <span class="care-icon coral"><i class="fas fa-kit-medical" aria-hidden="true"></i></span>
                <h3>Emergency & Outpatient</h3>
                <p>Urgent care, triage and clinical reviews when you need answers quickly.</p>
                <span class="card-link">Learn more <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
            <a asp-controller="Services" asp-action="MaternityChildHealth" class="care-card">
                <span class="care-icon rose"><i class="fas fa-baby" aria-hidden="true"></i></span>
                <h3>Maternity & Child Health</h3>
                <p>Supportive antenatal, delivery and newborn care for growing families.</p>
                <span class="card-link">Learn more <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
            <a asp-controller="Services" asp-action="DiagnosticsLab" class="care-card">
                <span class="care-icon teal"><i class="fas fa-microscope" aria-hidden="true"></i></span>
                <h3>Diagnostics & Laboratory</h3>
                <p>Reliable testing and imaging to guide clear, timely treatment decisions.</p>
                <span class="card-link">Learn more <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
            <a asp-controller="Services" asp-action="ChronicDisease" class="care-card">
                <span class="care-icon blue"><i class="fas fa-heart-circle-check" aria-hidden="true"></i></span>
                <h3>Chronic Disease Care</h3>
                <p>Consistent follow-up for diabetes, hypertension, TB and other conditions.</p>
                <span class="card-link">Learn more <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
    </div>
</section>

<section class="patient-story section-pad">
    <div class="container">
        <div class="story-grid">
            <div class="story-image">
                <img src="~/images/inside.JPG" alt="A bright and welcoming clinical area at Immaculate Heart Hospital" />
                <div class="story-badge"><strong>24/7</strong><span>care available</span></div>
            </div>
            <div class="story-copy">
                <span class="section-kicker">Why patients choose us</span>
                <h2>Clinical confidence with a human touch</h2>
                <p>We combine practical hospital expertise with respectful, family-centered care. Every patient receives clear communication and a coordinated path to treatment.</p>
                <div class="trust-list">
                    <div><span><i class="fas fa-user-doctor" aria-hidden="true"></i></span><p><strong>Experienced team</strong><small>Dedicated clinicians and support staff</small></p></div>
                    <div><span><i class="fas fa-clipboard-check" aria-hidden="true"></i></span><p><strong>Connected care</strong><small>Consultation, labs and treatment in one place</small></p></div>
                    <div><span><i class="fas fa-person-circle-check" aria-hidden="true"></i></span><p><strong>Patient first</strong><small>Dignity, comfort and clear next steps</small></p></div>
                </div>
                <a asp-controller="Home" asp-action="About" class="btn story-button">About our hospital</a>
            </div>
        </div>
    </div>
</section>

<section class="emergency-band">
    <div class="container emergency-inner">
        <div>
            <span class="emergency-label"><i class="fas fa-truck-medical" aria-hidden="true"></i> Emergency response</span>
            <h2>Need urgent help?</h2>
            <p>Call our round-the-clock team or request ambulance support.</p>
        </div>
        <div class="emergency-actions">
            <a href="tel:+254110361550" class="btn emergency-phone"><i class="fas fa-phone" aria-hidden="true"></i> +254 110 361 550</a>
            <a asp-controller="Services" asp-action="AmbulanceTransport" class="btn emergency-ambulance">Request ambulance <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
    </div>
</section>
