@{
    ViewData["Title"] = "Contact Us";
    ViewData["Description"] = "Contact Immaculate Heart Hospital Kereita for appointments, emergency support, ambulance dispatch and patient inquiries in Kiambu County, Kenya.";
    ViewData["Keywords"] = "Immaculate Heart Hospital contact, hospital phone number, hospital email, ambulance service Kenya";
    ViewData["OgImage"] = "https://immaculatehearthospitalkereita.org/images/gate view.JPG";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95)), url('/images/gate view.JPG'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="container py-5">
        <img src="~/images/logo.jpg" class="page-logo mb-4" alt="Immaculate Heart Hospital logo" />
        <h1 class="display-4 fw-bold mb-3">Get In Touch</h1>
        <p class="lead fw-bold mb-0" style="font-size: 1.5rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">Our team is available 24 hours a day, 7 days a week to support emergency calls, appointments, and inquiries.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <h2 class="text-primary fw-bold mb-4">Contact Details</h2>
            <div class="d-flex align-items-start mb-4">
                <div class="p-3 bg-light rounded border text-primary me-3"><i class="fa fa-building fs-5"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Physical Address</h5>
                    <p class="text-white mb-0">Kereita area, Near Kimende Town,<br>Lari Sub-County, Kiambu, Kenya</p>
                </div>
            </div>
            <div class="d-flex align-items-start mb-4">
                <div class="p-3 bg-light rounded border text-success me-3"><i class="fa fa-phone fs-5"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Emergency & Main Inquiries</h5>
                    <p class="text-white mb-0">Mobile Desk: <strong>+254 110 361 550</strong></p>
                    <p class="text-white small">Available round-the-clock for emergencies.</p>
                </div>
            </div>
            <div class="d-flex align-items-start mb-4">
                <div class="p-3 bg-light rounded border text-info me-3"><i class="fa fa-envelope fs-5"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Email Correspondence</h5>
                    <p class="text-white mb-0">info@immaculatehearthospitalkereita.org</p>
                </div>
            </div>
            <div class="p-4 bg-warning bg-opacity-10 border border-warning rounded">
                <h6 class="fw-bold text-dark mb-1">Dental Clinic Location</h6>
                <p class="small text-white mb-0">Our dental services operate from the Kimende clinic during standard daytime hours. Contact reception for scheduling.</p>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="row g-4">
                <div class="col-12">
                    <div class="card p-4 border shadow-sm rounded-3">
                        <h3 class="fw-bold text-dark mb-3">Send an Online Inquiry</h3>
                        <p class="text-white small mb-4">Fill out the form below and our administration desk will contact you promptly.</p>
                        <div id="contactMessage"></div>
                        <form id="contactForm" method="post" asp-action="Contact">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Full Name</label>
                                    <input type="text" name="fullName" class="form-control shadow-sm" placeholder="Your Name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Phone Number</label>
                                    <input type="tel" name="phone" class="form-control shadow-sm" placeholder="e.g. 0712345678" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold">Email Address</label>
                                    <input type="email" name="email" class="form-control shadow-sm" placeholder="name@example.com" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold">Subject / Inquiry Type</label>
                                    <select name="subject" class="form-select shadow-sm" required>
                                        <option>General Inquiry</option>
                                        <option>Maternity Booking</option>
                                        <option>Specialist Clinic Booking</option>
                                        <option>Insurance / Corporate Query</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold">Your Message</label>
                                    <textarea name="message" class="form-control shadow-sm" rows="4" placeholder="Type your detailed message here..." required></textarea>
                                </div>
                                <div class="col-12 mt-3">
                                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm w-100">Submit Message</button>
                                </div>
                            </div>
                        </form>
                        <script>
                            document.getElementById('contactForm').addEventListener('submit', async function(e) {
                                e.preventDefault();
                                
                                const formData = new FormData(this);
                                const submitBtn = this.querySelector('button[type="submit"]');
                                const messageDiv = document.getElementById('contactMessage');
                                submitBtn.disabled = true;
                                submitBtn.textContent = 'Sending...';
                                
                                try {
                                    const response = await fetch('@Url.Action("Contact")', {
                                        method: 'POST',
                                        body: formData
                                    });
                                    
                                    const result = await response.json();
                                    
                                    if (result.success) {
                                        messageDiv.innerHTML = '<div class="alert alert-success alert-dismissible fade show" role="alert">' + result.message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                                        this.reset();
                                    } else {
                                        messageDiv.innerHTML = '<div class="alert alert-warning alert-dismissible fade show" role="alert">' + result.message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                                    }
                                } catch (error) {
                                    messageDiv.innerHTML = '<div class="alert alert-danger alert-dismissible fade show" role="alert">Error sending message. Please try again.<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                                } finally {
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = 'Submit Message';
                                }
                            });
                        </script>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="py-5 bg-light border-top">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="text-primary fw-bold">Find Us on the Map</h2>
            <p class="text-white">Located in Kereita, Kiambu County - accessible from Kimende Town</p>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="rounded-3 overflow-hidden shadow-lg" style="height: 450px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.757896548387!2d36.66638!3d-1.18622!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x182f1c8e0f0f0f0f%3A0x0f0f0f0f0f0f0f0f!2sImmaculate%20Heart%20Hospital%20Kereita!5e0!3m2!1sen!2ske!4v1234567890" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>