@{
    ViewData["Title"] = "Emergency & Outpatient Services";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Emergency & Outpatient Services</h1>
        <p class="lead mb-0">24/7 emergency care and urgent outpatient clinical support.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Always Ready to Help</h2>
            <p class="text-white lead">Our emergency and outpatient services operate around the clock to address acute medical conditions and urgent care needs.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">What We Offer</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>24/7 Emergency Triage</strong> - Rapid assessment and stabilization of critical conditions</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Urgent Care Consultations</strong> - Professional evaluation for acute symptoms</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Wound Care & Stitching</strong> - Minor injuries and trauma management</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Outpatient Clinical Reviews</strong> - Follow-up care for both acute and chronic conditions</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Stabilization & Transfer</strong> - Critical patient stabilization and safe transfer to higher facilities</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">When to Seek Emergency Care</h4>
                <p class="text-white small mb-3">Visit our emergency department immediately if you experience:</p>
                <ul class="text-white small ps-3">
                    <li>Chest pain or difficulty breathing</li>
                    <li>Severe bleeding or injuries</li>
                    <li>Loss of consciousness</li>
                    <li>Severe abdominal pain</li>
                    <li>Sudden severe headache</li>
                    <li>Poisoning or overdose</li>
                    <li>Severe allergic reactions</li>
                    <li>Trauma or serious accidents</li>
                </ul>
                <hr class="my-4">
                <h5 class="text-dark fw-bold mb-2">Emergency Contact</h5>
                <p class="mb-0"><i class="bi bi-telephone-fill text-primary me-2"></i><a href="tel:+254722123456" class="text-primary fw-bold">+254 722 123 456</a></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Our Emergency Team</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-person-check-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Trained Emergency Physicians</h5>
                    <p class="text-white small">Experienced doctors trained in emergency medicine and trauma care.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-heart-pulse-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Modern Life Support Equipment</h5>
                    <p class="text-white small">Advanced monitoring and resuscitation equipment for critical care.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-shield-check fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Rapid Response Protocol</h5>
                    <p class="text-white small">Coordinated emergency response with faster triage and treatment.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Our Commitment to Emergency Care</h3>
            <p class="text-white">At Immaculate Heart Hospital Kereita, we understand that emergencies can happen anytime. Our dedicated emergency team is available 24/7 to provide rapid response, expert care, and compassionate support when you need it most. Whether it's a life-threatening emergency or an urgent outpatient consultation, we are here for you.</p>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Quick Access</h5>
                <a asp-controller="Services" asp-action="EmergencyCare" class="btn btn-warning btn-sm fw-bold mb-2">Get Emergency Care Info</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Contact Reception</a>
            </div>
        </div>
    </div>
</section>
