@{
    ViewData["Title"] = "Clinic Appointments";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Clinic Appointments</h1>
        <p class="lead mb-0">Schedule your visit with our healthcare professionals.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Book Your Clinic Visit</h2>
            <p class="text-white lead">Easy appointment scheduling for all our medical departments and clinics.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Available Clinics</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-heart-pulse-fill text-primary me-2"></i>
                        <span class="text-white"><strong>General Outpatient Clinic</strong> - Common medical conditions and consultations</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-heart-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Maternity & Child Health</strong> - Prenatal care, delivery, and pediatric services</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-person-check-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Chronic Disease Clinics</strong> - Diabetes, Hypertension, TB, and Arthritis management</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-tooth-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Dental Clinic</strong> - Dental examinations and treatments</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-activity text-primary me-2"></i>
                        <span class="text-white"><strong>Physiotherapy</strong> - Rehabilitation and physical therapy</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Clinic Hours</h4>
                <p class="text-white small mb-3">Most clinics are available during these hours:</p>
                <ul class="text-white small ps-3">
                    <li><strong>Monday - Friday:</strong> 8:00 AM - 5:00 PM</li>
                    <li><strong>Saturday:</strong> 8:00 AM - 2:00 PM</li>
                    <li><strong>Sunday:</strong> By appointment only</li>
                </ul>
                <hr class="my-4">
                <h5 class="text-dark fw-bold mb-2">Call to Book</h5>
                <p class="text-white small mb-0"><i class="bi bi-telephone-fill me-2"></i><a href="tel:+254722123456" class="text-primary">+254 722 123 456</a></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">How to Schedule Your Appointment</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-telephone-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Call Reception</h5>
                    <p class="text-white small">Ring our main reception line to book your appointment.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-envelope-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Email Request</h5>
                    <p class="text-white small">Send appointment request via email with your preferred date and clinic.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-building fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Visit Reception</h5>
                    <p class="text-white small">Walk into reception and our staff will schedule you.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-chat-left-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Message Us</h5>
                    <p class="text-white small">Contact via messaging system for scheduling requests.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">What to Bring</h3>
            <p class="text-white mb-3">To your clinic appointment, please bring:</p>
            <ul class="text-white">
                <li class="mb-2"><strong>Valid ID:</strong> National ID, passport, or other identification</li>
                <li class="mb-2"><strong>Insurance Card:</strong> If you have health insurance coverage</li>
                <li class="mb-2"><strong>Medical History:</strong> List of current medications and conditions</li>
                <li class="mb-2"><strong>Referral Letter:</strong> If referred from another doctor</li>
                <li class="mb-2"><strong>Previous Reports:</strong> Any recent lab or imaging results</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Book Your Appointment Now</h5>
                <p class="small mb-3">Contact our reception team to schedule your clinic visit.</p>
                <a href="tel:+254722123456" class="btn btn-warning btn-sm fw-bold mb-2">Call to Book</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Send Request</a>
            </div>
        </div>
    </div>
</section>
