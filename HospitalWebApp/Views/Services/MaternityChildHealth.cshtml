@{
    ViewData["Title"] = "Maternity & Child Health Services";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Maternity & Child Health</h1>
        <p class="lead mb-0">Comprehensive care from pregnancy through early childhood.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Family-Centered Maternity Care</h2>
            <p class="text-secondary lead">We believe pregnancy and childbirth should be a joyful experience supported by expert medical care and compassionate support.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Our Maternity Services</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Antenatal Monitoring</strong> - Regular check-ups and screening throughout pregnancy</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Safe Delivery Care</strong> - Professional assisted and emergency obstetric support</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Postnatal Follow-up</strong> - Mother and newborn care after delivery</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Newborn Immunizations</strong> - Comprehensive vaccination programs from birth</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Family Support Services</strong> - Counseling and education for new parents</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Child Health Services</h4>
                <p class="text-muted small mb-3">Comprehensive pediatric care from infancy through childhood:</p>
                <ul class="text-muted small ps-3">
                    <li>Routine child health checks and growth monitoring</li>
                    <li>Full immunization schedule implementation</li>
                    <li>Treatment of common childhood illnesses</li>
                    <li>Nutritional guidance and feeding support</li>
                    <li>Developmental screening and assessment</li>
                    <li>Management of congenital conditions</li>
                    <li>Emergency pediatric care</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Our Maternity & Pediatric Team</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-person-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Experienced Obstetricians</h5>
                    <p class="text-muted small">Specialists in pregnancy, delivery, and maternal health with proven track records.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-heart-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Pediatric Care Specialists</h5>
                    <p class="text-muted small">Child health experts dedicated to ensuring healthy growth and development.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-hand-thumbs-up-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Compassionate Support</h5>
                    <p class="text-muted small">Trained midwives and nurses providing emotional and physical support throughout the journey.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Prenatal Classes & Education</h3>
            <p class="text-secondary">We offer comprehensive prenatal education programs covering labor preparation, breastfeeding, and newborn care. Our experienced educators help expectant parents prepare for this exciting journey with confidence.</p>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Schedule Your Visit</h5>
                <p class="small mb-3">Contact our maternity department to book your appointment or attend our prenatal classes.</p>
                <a asp-controller="Services" asp-action="ClinicAppointments" class="btn btn-warning btn-sm fw-bold mb-2">Book an Appointment</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Speak with Our Team</a>
            </div>
        </div>
    </div>
</section>
