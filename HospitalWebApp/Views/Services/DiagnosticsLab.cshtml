@{
    ViewData["Title"] = "Diagnostics & Lab Work";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Diagnostics & Lab Work</h1>
        <p class="lead mb-0">Advanced testing and imaging for accurate diagnosis and treatment planning.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Accurate Diagnosis, Better Treatment</h2>
            <p class="text-white lead">Our state-of-the-art laboratory and diagnostic imaging services provide clinicians with the precise information needed for effective treatment decisions.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Laboratory & Diagnostic Services</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Pathology Services</strong> - Complete blood work and tissue analysis</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Blood Testing</strong> - Comprehensive metabolic panels and disease screening</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Ultrasound Imaging</strong> - High-quality diagnostic imaging for internal organs</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Rapid Lab Results</strong> - Quick turnaround for urgent test results</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Infectious Disease Testing</strong> - Screening for common and serious infections</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Available Tests</h4>
                <p class="text-white small mb-3">We offer a comprehensive range of diagnostic tests:</p>
                <ul class="text-white small ps-3">
                    <li>Complete Blood Count (CBC)</li>
                    <li>Liver and Kidney Function Tests</li>
                    <li>Blood Sugar and Lipid Panels</li>
                    <li>HIV, Typhoid, and Malaria Screening</li>
                    <li>Pregnancy Tests (HCG)</li>
                    <li>Urinalysis and Stool Tests</li>
                    <li>Microbiology and Culture Tests</li>
                    <li>Abdominal and Obstetric Ultrasound</li>
                </ul>
                <hr class="my-4">
                <p class="text-white small mb-0"><strong>All samples are processed with strict quality control and biohazard safety protocols.</strong></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Our Diagnostic Capabilities</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-microscope fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Laboratory Equipment</h5>
                    <p class="text-white small">Modern automated laboratory equipment for accurate and rapid analysis.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-graph-up fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Qualified Technicians</h5>
                    <p class="text-white small">Trained and certified laboratory technologists ensuring test accuracy.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-shield-check fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Quality Assurance</h5>
                    <p class="text-white small">Strict quality control protocols and accreditation standards compliance.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">How Our Lab Works</h3>
            <p class="text-white mb-3">Our streamlined process ensures accurate results with minimal wait time:</p>
            <ol class="text-white">
                <li class="mb-2">Sample collection with professional phlebotomists</li>
                <li class="mb-2">Quick processing using modern equipment</li>
                <li class="mb-2">Analysis by qualified laboratory technologists</li>
                <li class="mb-2">Quality review and verification</li>
                <li class="mb-2">Rapid results delivery to your healthcare provider</li>
            </ol>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Schedule Your Tests</h5>
                <p class="small mb-3">Contact our laboratory to book your diagnostic tests. No appointment needed for walk-in lab services.</p>
                <a asp-controller="Services" asp-action="LaboratoryTests" class="btn btn-warning btn-sm fw-bold mb-2">View Lab Services</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Contact Lab Department</a>
            </div>
        </div>
    </div>
</section>
