@{
    ViewData["Title"] = "Chronic Disease Clinics";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Chronic Disease Clinics</h1>
        <p class="lead mb-0">Structured follow-up care for long-term disease management.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Managing Chronic Conditions</h2>
            <p class="text-secondary lead">Our specialized chronic disease clinics provide structured, ongoing care to help you manage your condition effectively and prevent complications.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Conditions We Manage</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Diabetes</strong> - Blood sugar management, lifestyle coaching, and complication prevention</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Hypertension (High Blood Pressure)</strong> - Blood pressure control and cardiovascular risk management</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Tuberculosis (TB)</strong> - Directly observed therapy and monitoring</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Arthritis</strong> - Pain management, mobility preservation, and functional improvement</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Our Clinic Approach</h4>
                <p class="text-muted small mb-3">We provide holistic chronic disease management:</p>
                <ul class="text-muted small ps-3">
                    <li>Regular clinic appointments on a scheduled basis</li>
                    <li>Medication management and adjustment</li>
                    <li>Lifestyle and dietary counseling</li>
                    <li>Regular laboratory monitoring</li>
                    <li>Complication screening and prevention</li>
                    <li>Patient education on disease management</li>
                    <li>Coordination with specialists when needed</li>
                </ul>
                <hr class="my-4">
                <p class="text-muted small mb-0"><strong>Early detection and consistent management prevent serious complications and improve quality of life.</strong></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Why Choose Our Chronic Disease Clinics</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-calendar-check-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Scheduled Continuity</h5>
                    <p class="text-muted small">Consistent follow-up appointments ensure uninterrupted care and disease monitoring.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-people-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Expert Team</h5>
                    <p class="text-muted small">Doctors and nurses specialized in chronic disease management and patient education.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-graph-up-arrow fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Better Outcomes</h5>
                    <p class="text-muted small">Structured care reduces complications and improves long-term health outcomes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Complication Prevention</h3>
            <p class="text-secondary mb-3">Regular monitoring and consistent treatment help prevent serious complications:</p>
            <ul class="text-secondary">
                <li class="mb-2"><strong>Diabetes:</strong> Eye exams, kidney monitoring, nerve assessments</li>
                <li class="mb-2"><strong>Hypertension:</strong> Heart health checks, stroke risk assessment</li>
                <li class="mb-2"><strong>TB:</strong> Regular sputum tests and symptom monitoring</li>
                <li class="mb-2"><strong>Arthritis:</strong> Joint function assessment and physical therapy</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Enroll in a Clinic</h5>
                <p class="small mb-3">Join our chronic disease clinics for ongoing, structured care management.</p>
                <a asp-controller="Services" asp-action="ClinicAppointments" class="btn btn-warning btn-sm fw-bold mb-2">Schedule Clinic Visit</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Get More Information</a>
            </div>
        </div>
    </div>
</section>
