@{
    ViewData["Title"] = "Billing Support";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Billing Support</h1>
        <p class="lead mb-0">Clear pricing, transparent billing, and flexible payment options.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">We Make Billing Simple</h2>
            <p class="text-secondary lead">At Immaculate Heart Hospital, we believe healthcare should be accessible and affordable. Our billing department is here to help.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">How We Help</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Transparent Pricing</strong> - Itemized bills showing all charges clearly</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Insurance Coordination</strong> - We work with your insurance provider</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Flexible Payment Plans</strong> - Payment options to fit your budget</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Financial Assistance</strong> - Discuss discounts and support programs</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-secondary"><strong>Bill Explanation</strong> - Clarification of charges and itemized services</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Billing Department</h4>
                <p class="text-muted small mb-4">Contact our billing team for any inquiries:</p>
                
                <div class="mb-4">
                    <h5 class="text-dark fw-bold mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i>Phone</h5>
                    <p class="text-muted small mb-0"><a href="tel:+254722123456" class="text-primary">+254 722 123 456</a></p>
                </div>

                <div class="mb-4">
                    <h5 class="text-dark fw-bold mb-2"><i class="bi bi-envelope-fill text-primary me-2"></i>Email</h5>
                    <p class="text-muted small mb-0"><a href="mailto:billing@immaculatehearthospitalkereita.org" class="text-primary">billing@immaculatehearthospitalkereita.org</a></p>
                </div>

                <div>
                    <h5 class="text-dark fw-bold mb-2"><i class="bi bi-clock-fill text-primary me-2"></i>Hours</h5>
                    <p class="text-muted small mb-0">Monday - Friday: 8:00 AM - 5:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Payment Options</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-cash-coin fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Cash Payment</h5>
                    <p class="text-muted small">Pay in full at reception or billing department. Receipts issued immediately.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-credit-card-2-front-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Card Payment</h5>
                    <p class="text-muted small">Debit and credit cards accepted at billing department with secure processing.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-phone-vibrate-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Mobile Money (M-Pesa)</h5>
                    <p class="text-muted small">Pay via M-Pesa for convenient mobile payment processing.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Understanding Your Bill</h3>
            <p class="text-secondary mb-3">Your hospital bill includes:</p>
            <ul class="text-secondary">
                <li class="mb-2"><strong>Consultation Fees:</strong> Doctor/specialist fees for services</li>
                <li class="mb-2"><strong>Laboratory Tests:</strong> Cost of diagnostic testing</li>
                <li class="mb-2"><strong>Medications:</strong> Drugs dispensed during treatment</li>
                <li class="mb-2"><strong>Procedures:</strong> Surgical or clinical procedures performed</li>
                <li class="mb-2"><strong>Room Charges:</strong> Inpatient accommodation fees</li>
                <li class="mb-2"><strong>Imaging/Ultrasound:</strong> Diagnostic imaging services</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Questions About Your Bill?</h5>
                <p class="small mb-3">Our billing team is ready to help clarify any charges or discuss payment options.</p>
                <a href="tel:+254722123456" class="btn btn-light btn-sm fw-bold mb-2">Call Billing</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Send Inquiry</a>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
        <h3 class="text-primary fw-bold text-center mb-5">Financial Assistance Programs</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4">
                    <h5 class="h6 fw-bold text-dark mb-3">Insurance Billing</h5>
                    <p class="text-muted small">We process claims with most insurance providers. Bring your insurance details at admission.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-4">
                    <h5 class="h6 fw-bold text-dark mb-3">Discounts & Support</h5>
                    <p class="text-muted small">Ask our billing staff about available discounts for low-income patients and community support programs.</p>
                </div>
            </div>
        </div>
    </div>
</section>
