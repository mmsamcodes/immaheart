@{
    ViewData["Title"] = "Physiotherapy & Rehabilitation Services";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Physiotherapy & Rehabilitation</h1>
        <p class="lead mb-0">Restoring movement, strength, and independence.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Recover with Confidence</h2>
            <p class="text-white lead">Our physiotherapy program helps patients regain mobility, strength, and independence through evidence-based rehabilitation techniques.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Rehabilitation Services</h4>
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Injury Recovery</strong> - Structured rehabilitation after trauma or surgery</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Movement Restoration</strong> - Regaining range of motion and flexibility</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Muscle Strengthening</strong> - Guided exercises to rebuild muscular strength</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Pain Management</strong> - Techniques to reduce pain and improve function</span>
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white"><strong>Functional Training</strong> - Preparing for return to daily activities</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Conditions We Treat</h4>
                <p class="text-white small mb-3">Our team specializes in rehabilitation for:</p>
                <ul class="text-white small ps-3">
                    <li>Post-surgical recovery</li>
                    <li>Orthopedic injuries (fractures, sprains, strains)</li>
                    <li>Neurological conditions</li>
                    <li>Cardiovascular recovery</li>
                    <li>Chronic pain conditions</li>
                    <li>Mobility and balance disorders</li>
                    <li>Joint and muscle dysfunction</li>
                </ul>
                <hr class="my-4">
                <p class="text-white small mb-0"><strong>Each patient receives a personalized rehabilitation plan tailored to their specific needs and goals.</strong></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">Our Physiotherapy Approach</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-person-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Qualified Physiotherapists</h5>
                    <p class="text-white small">Licensed therapists trained in modern rehabilitation and evidence-based practices.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-tools fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Modern Equipment</h5>
                    <p class="text-white small">Advanced rehabilitation equipment and therapy tools for effective treatment.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                    <div class="text-primary mb-3"><i class="bi bi-bar-chart-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Measurable Progress</h5>
                    <p class="text-white small">Regular assessment and progress tracking to ensure effective rehabilitation outcomes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Your Rehabilitation Journey</h3>
            <p class="text-white mb-3">We guide you through every step of recovery:</p>
            <ol class="text-white">
                <li class="mb-2"><strong>Initial Assessment:</strong> Comprehensive evaluation of your condition and goals</li>
                <li class="mb-2"><strong>Treatment Planning:</strong> Customized rehabilitation program</li>
                <li class="mb-2"><strong>Guided Sessions:</strong> One-on-one therapy and exercise instruction</li>
                <li class="mb-2"><strong>Home Exercises:</strong> Ongoing activities to support recovery</li>
                <li class="mb-2"><strong>Progress Monitoring:</strong> Regular check-ins and plan adjustments</li>
                <li class="mb-2"><strong>Return to Function:</strong> Safe transition to independent activity</li>
            </ol>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Start Your Recovery</h5>
                <p class="small mb-3">Schedule a physiotherapy consultation to begin your rehabilitation program.</p>
                <a asp-controller="Services" asp-action="ClinicAppointments" class="btn btn-warning btn-sm fw-bold mb-2">Book PT Appointment</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Speak with Our Team</a>
            </div>
        </div>
    </div>
</section>
