@{
    ViewData["Title"] = "Laboratory Tests";
}

<section class="bg-primary text-white text-center py-5" style="background: linear-gradient(rgba(0, 74, 153, 0.9), rgba(0, 40, 90, 0.95));">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Laboratory Tests</h1>
        <p class="lead mb-0">Accurate diagnostic testing with rapid results.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <h2 class="text-primary fw-bold mb-3">Book Your Lab Tests</h2>
            <p class="text-white lead">Our modern laboratory provides comprehensive testing services with quick turnaround times.</p>
            
            <div class="mt-4">
                <h4 class="text-dark fw-bold mb-3">Common Lab Tests Available</h4>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Complete Blood Count (CBC)</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Liver & Kidney Function Tests</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Blood Sugar (Glucose) & Lipid Panel</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">HIV, Malaria & Typhoid Screening</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Pregnancy Test (HCG)</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Urinalysis & Stool Tests</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                        <span class="text-white">Microbiology & Culture Tests</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-light">
                <h4 class="text-dark fw-bold mb-3">Lab Hours</h4>
                <p class="text-white small mb-3">Sample collection available:</p>
                <ul class="text-white small ps-3">
                    <li><strong>Weekdays:</strong> 7:00 AM - 5:00 PM</li>
                    <li><strong>Saturdays:</strong> 8:00 AM - 2:00 PM</li>
                    <li><strong>Sundays:</strong> 9:00 AM - 12:00 PM</li>
                    <li><strong>Emergencies:</strong> Available 24/7</li>
                </ul>
                <hr class="my-4">
                <h5 class="text-dark fw-bold mb-2">Contact Lab</h5>
                <p class="text-white small mb-0"><i class="bi bi-telephone-fill me-2"></i><a href="tel:+254722123456" class="text-primary">+254 722 123 456</a></p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5 border-top border-bottom">
    <div class="container">
        <h2 class="text-primary fw-bold text-center mb-5">How to Get Your Lab Tests Done</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-1-circle-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Book or Walk-In</h5>
                    <p class="text-white small">No appointment needed, or book ahead for convenience.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-2-circle-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Sample Collection</h5>
                    <p class="text-white small">Quick, professional blood or sample collection by trained phlebotomists.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-3-circle-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Processing</h5>
                    <p class="text-white small">Modern equipment processes samples with quality assurance.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-4 h-100 text-center">
                    <div class="text-primary mb-3"><i class="bi bi-4-circle-fill fs-2"></i></div>
                    <h5 class="h6 fw-bold text-dark">Results</h5>
                    <p class="text-white small">Rapid results provided to you or your doctor.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-primary fw-bold mb-3">Prepare for Your Test</h3>
            <p class="text-white mb-3">To ensure accurate results:</p>
            <ul class="text-white">
                <li class="mb-2"><strong>Fasting Tests:</strong> Don't eat for 8-12 hours before blood test</li>
                <li class="mb-2"><strong>Hydration:</strong> Drink water normally before tests</li>
                <li class="mb-2"><strong>Medications:</strong> Inform staff of medications you're taking</li>
                <li class="mb-2"><strong>List of Tests:</strong> Bring doctor's request form if available</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-primary text-white">
                <h5 class="fw-bold mb-3">Schedule Your Tests</h5>
                <p class="small mb-3">Contact our laboratory or visit for sample collection.</p>
                <a asp-controller="Services" asp-action="ClinicAppointments" class="btn btn-warning btn-sm fw-bold mb-2">Book Lab Tests</a>
                <br>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-sm fw-bold">Contact Lab Department</a>
            </div>
        </div>
    </div>
</section>
