                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(118,75,162,0.1));">
                <form id="periodForm">
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold">📅 Start Date</label>
                        <input type="date" id="periodStart" class="form-control fw-bold" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold">📅 End Date (Optional)</label>
                        <input type="date" id="periodEnd" class="form-control fw-bold">
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold">💧 Flow Intensity</label>
                        <select id="flowIntensity" class="form-select fw-bold">
                            <option>Light</option>
                            <option selected>Normal</option>
                            <option>Heavy</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold">💭 Symptoms (Optional)</label>
                        <textarea id="symptoms" class="form-control fw-bold" rows="3" placeholder="cramps, mood changes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4" style="background: linear-gradient(135deg, rgba(102,126,234,0.05), rgba(118,75,162,0.05));">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-neon fw-bold" onclick="savePeriod()">✅ SAVE</button>
            </div>
        </div>
    </div>
</div>

<script>
    function calcAdultBMI() {
        let w = parseFloat(document.getElementById('adultWeight').value);
        let h = parseFloat(document.getElementById('adultHeight').value) / 100;
        if(w > 0 && h > 0) {
            let bmi = (w / (h * h)).toFixed(1);
            document.getElementById('adultResult').innerHTML = bmi;
            let status = (bmi < 18.5) ? "🟢 Underweight" : (bmi < 25) ? "🟢 Healthy" : (bmi < 30) ? "🟡 Overweight" : "🔴 Obese";
            document.getElementById('adultStatus').innerHTML = status;
        }
    }

    function calcChildBMI() {
        let w = parseFloat(document.getElementById('cWeight').value);
        let h = parseFloat(document.getElementById('cHeight').value) / 100;
        if(w > 0 && h > 0) {
            let bmi = (w / (h * h)).toFixed(1);
            document.getElementById('pResult').innerHTML = bmi;
            let status = (bmi < 14) ? "🟢 Underweight" : (bmi < 18) ? "🟢 Healthy" : "🟡 Overweight";
            document.getElementById('pStatus').innerHTML = status;
        }
    }

    function savePeriod() {
        let startDate = document.getElementById('periodStart').value;
        if(startDate) {
            localStorage.setItem('lastPeriodStart', startDate);
            localStorage.setItem('lastPeriodFlow', document.getElementById('flowIntensity').value);
            alert('✅ Period logged! We\'re tracking your cycle! 📅');
            document.getElementById('periodForm').reset();
            bootstrap.Modal.getInstance(document.getElementById('periodModal')).hide();
            location.reload();
        }
    }

    function checkPaymentAndBook(type) {
        let paidAmount = parseFloat('@Model.PaidAmount');
        if(paidAmount > 0) {
            window.location.href = type === 'telehealth' ? '/Appointments/Create?type=telehealth' : '/Appointments/Create?type=inperson';
        } else {
            alert('⚠️ Complete payment first! Heading to billing...');
            window.location.href = '/Billing/Index';
        }
    }
</script>
