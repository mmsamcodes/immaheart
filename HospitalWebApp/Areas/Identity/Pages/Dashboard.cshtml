@page
@model HospitalWebApp.Areas.Identity.Pages.DashboardModel
@{
    ViewData["Title"] = "Patient Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    * { transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }

    @@keyframes rainbowShift {
        0% { filter: hue-rotate(0deg); }
        100% { filter: hue-rotate(360deg); }
    }

    @@keyframes bounceScale {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.08); }
    }

    @@keyframes shimmerFast {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
    }

    @@keyframes floatBig {
        0%, 100% { transform: translateY(-15px) rotateZ(-2deg); }
        50% { transform: translateY(5px) rotateZ(2deg); }
    }

    @@keyframes glowPulse {
        0%, 100% { box-shadow: 0 0 20px rgba(255,50,100,0.6), 0 0 40px rgba(100,200,255,0.4), inset 0 0 10px rgba(255,255,255,0.1); }
        50% { box-shadow: 0 0 40px rgba(255,50,100,0.8), 0 0 80px rgba(100,200,255,0.6), inset 0 0 20px rgba(255,255,255,0.2); }
    }

    @@keyframes rotateBorder {
        0% { border-image: linear-gradient(135deg, #ff0080, #ff8c00, #40e0d0, #ff0080) 1; transform: rotateZ(0deg); }
        100% { border-image: linear-gradient(225deg, #ff0080, #ff8c00, #40e0d0, #ff0080) 1; transform: rotateZ(360deg); }
    }

    body {
        background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
        min-height: 100vh;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .dashboard-container {
        background: linear-gradient(135deg, rgba(255,0,127,0.05) 0%, rgba(0,200,255,0.05) 50%, rgba(255,200,0,0.05) 100%);
        min-height: 100vh;
        padding: 2rem 0 4rem;
        backdrop-filter: blur(10px);
    }

    .hero-banner {
        background: linear-gradient(135deg, #ff006e 0%, #8338ec 25%, #3a86ff 50%, #06ffa5 75%, #ffbe0b 100%);
        background-size: 300% 300%;
        animation: gradientShift 8s ease infinite, glowPulse 3s ease-in-out infinite;
        color: white;
        padding: 3rem;
        border-radius: 30px;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        border: 3px solid rgba(255,255,255,0.3);
        box-shadow: 0 0 60px rgba(255,0,110,0.5), 0 20px 60px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    }

    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px);
        background-size: 50px 50px;
        animation: floatBig 20s linear infinite;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-shadow: 0 8px 20px rgba(0,0,0,0.4), 0 0 40px rgba(255,255,255,0.3);
        letter-spacing: -2px;
        position: relative;
        z-index: 2;
    }

    .hero-subtitle {
        font-size: 1.3rem;
        font-weight: 600;
        text-shadow: 0 4px 10px rgba(0,0,0,0.3);
        position: relative;
        z-index: 2;
        line-height: 1.8;
    }

    /* MEGA VIBRANT CARDS */
    .stat-card {
        border-radius: 25px;
        border: 2px solid rgba(255,255,255,0.2);
        overflow: hidden;
        position: relative;
        height: 100%;
        animation: bounceScale 2.5s ease-in-out infinite, glowPulse 3s ease-in-out infinite;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
        transform: perspective(1000px) rotateX(0deg);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        animation: shimmerFast 2s infinite;
    }

    .stat-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.2), transparent);
    }

    .stat-card:hover {
        transform: translateY(-15px) scale(1.05) rotateX(5deg);
        box-shadow: 0 30px 80px rgba(0,0,0,0.4), inset 0 2px 0 rgba(255,255,255,0.3);
        border-color: rgba(255,255,255,0.4);
    }

    /* ULTRA VIBRANT GRADIENTS */
    .card-neon-pink { background: linear-gradient(135deg, #ff006e 0%, #ff3385 50%, #ff66cc 100%); }
    .card-neon-blue { background: linear-gradient(135deg, #0096ff 0%, #00d4ff 50%, #0ff0fe 100%); }
    .card-neon-purple { background: linear-gradient(135deg, #8338ec 0%, #b344ff 50%, #ff44e0 100%); }
    .card-neon-green { background: linear-gradient(135deg, #06ffa5 0%, #00ff88 50%, #20ff8c 100%); }
    .card-neon-orange { background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 50%, #ffa94d 100%); }
    .card-neon-yellow { background: linear-gradient(135deg, #ffbe0b 0%, #ffd60a 50%, #ffc300 100%); }
    .card-neon-cyan { background: linear-gradient(135deg, #00f5ff 0%, #00ffff 50%, #40e0d0 100%); }
    .card-neon-magenta { background: linear-gradient(135deg, #ff1493 0%, #ff69b4 50%, #ffb6c1 100%); }
    .card-neon-lime { background: linear-gradient(135deg, #32cd32 0%, #00ff00 50%, #90ee90 100%); }

    .icon-mega {
        font-size: 5rem;
        animation: floatBig 3s ease-in-out infinite;
        filter: drop-shadow(0 8px 15px rgba(0,0,0,0.3));
        margin-bottom: 1.5rem;
    }

    .card-text {
        color: white;
        text-shadow: 0 3px 8px rgba(0,0,0,0.3);
        font-weight: 700;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 900;
        color: white;
        text-shadow: 0 4px 10px rgba(0,0,0,0.4);
        letter-spacing: 1px;
    }

    .section-title {
        font-size: 2.2rem;
        font-weight: 900;
        color: white;
        text-shadow: 0 4px 12px rgba(0,0,0,0.4);
        letter-spacing: 2px;
        margin-top: 1rem;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
        padding: 1rem 2rem;
        border-radius: 20px;
        border-left: 6px solid rgba(255,255,255,0.5);
        animation: slideInRight 0.6s ease;
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .divider-gradient {
        height: 4px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
        margin: 3rem 0;
        border-radius: 2px;
        box-shadow: 0 2px 15px rgba(255,255,255,0.2);
    }

    .btn-neon {
        background: rgba(255,255,255,0.95);
        color: #333;
        border: none;
        font-weight: 900;
        border-radius: 15px;
        padding: 0.8rem 2rem;
        font-size: 1.1rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-neon:hover {
        transform: translateY(-5px) scale(1.08);
        box-shadow: 0 15px 40px rgba(0,0,0,0.35);
        background: white;
    }

    .badge-neon {
        background: rgba(255,255,255,0.3) !important;
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255,255,255,0.5);
        padding: 0.8rem 1.5rem !important;
        font-size: 1.1rem !important;
        font-weight: 900 !important;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .progress-container {
        background: rgba(255,255,255,0.2);
        border-radius: 15px;
        padding: 0.5rem;
        margin-top: 1rem;
    }

    .progress-bar-neon {
        background: linear-gradient(90deg, #ffbe0b, #ff006e, #0096ff) !important;
        height: 12px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(255,190,11,0.6);
        animation: shimmerFast 3s infinite;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 900;
        background: linear-gradient(135deg, #ff006e, #8338ec, #3a86ff, #06ffa5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 4px 10px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
        letter-spacing: -1px;
    }

    .divider-gradient {
        height: 4px;
        background: linear-gradient(90deg, #ff006e, #8338ec, #3a86ff, #06ffa5, #ffbe0b, #ff006e);
        border-radius: 10px;
        margin: 2rem 0;
        box-shadow: 0 0 20px rgba(255,0,110,0.4);
    }

    .modal-content {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .modal-header {
        background: linear-gradient(135deg, #ff006e 0%, #8338ec 100%);
        border: none;
        border-radius: 20px 20px 0 0;
    }

    .modal-title {
        font-weight: 900;
        font-size: 1.4rem;
        text-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }

    .form-control, .form-select {
        background: rgba(255,255,255,0.95);
        border: 2px solid rgba(102, 126, 234, 0.3);
        border-radius: 12px;
        padding: 0.8rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ff006e;
        box-shadow: 0 0 20px rgba(255, 0, 110, 0.3);
    }

    .form-label {
        color: white;
        font-weight: 900;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    @@media (max-width: 768px) {
        .hero-title { font-size: 2.5rem; }
        .hero-subtitle { font-size: 1.1rem; }
        .icon-mega { font-size: 3.5rem; }
    }
</style>

<div class="dashboard-container">
    <div class="container py-4">
        <!-- HERO BANNER -->
        <div class="hero-banner">
            <div class="position-relative z-2">
                <h1 class="hero-title mb-3">✨ Welcome Back, @Model.FullName! 🎉</h1>
                <p class="hero-subtitle mb-4">Your personalized health dashboard is ready to rock! 💪 Track BMI, appointments, billing, lab results, and telehealth—all from one magical place.</p>
                <div class="d-flex flex-wrap gap-3">
                    <span class="badge badge-neon badge-pill text-white">🎯 Patient Dashboard</span>
                    <span class="badge badge-neon badge-pill text-white">🔒 Secure Access</span>
                    <span class="badge badge-neon badge-pill text-white">⚡ Lightning Fast</span>
                    <span class="badge badge-neon badge-pill text-white">🌈 Gorgeous UI</span>
                </div>
            </div>
        </div>

        <!-- TOP 3 MEGA CARDS -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card stat-card card-neon-pink border-0 text-white h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div class="icon-mega">❤️</div>
                        <h5 class="card-title mb-2">BMI STATUS</h5>
                        <div class="display-2 fw-bold mb-2" style="text-shadow: 0 4px 8px rgba(0,0,0,0.3);">@Model.BMI.ToString("F1")</div>
                        <div class="badge badge-neon text-white mb-3">@Model.BMICategory</div>
                        <div class="progress-container">
                            <div class="progress" style="height: 12px;">
                                <div class="progress-bar progress-bar-neon" style="width: @(Math.Min(Model.BMI * 5, 100))%"></div>
                            </div>
                        </div>
                        <p class="card-text mt-3">💪 Keep it up!</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card stat-card card-neon-cyan border-0 text-white h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div class="icon-mega">📅</div>
                        <h5 class="card-title mb-2">CYCLE PHASE</h5>
                        <div class="rounded-circle d-inline-block mx-auto p-4 mb-3" style="background: rgba(255,255,255,0.25); border: 3px solid rgba(255,255,255,0.5);">
                            <h2 class="mb-0 text-white fw-bold">Day @Model.DayOfCycle</h2>
                        </div>
                        <h4 class="card-text mb-3">@Model.CyclePhase</h4>
                        <button class="btn btn-neon fw-bold w-100" data-bs-toggle="modal" data-bs-target="#periodModal">📝 LOG PERIOD</button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card stat-card card-neon-orange border-0 text-white h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div class="icon-mega">🎥</div>
                        <h5 class="card-title mb-2">BOOK NOW</h5>
                        <p class="card-text mb-4">In-person or Virtual 🏥</p>
                        <a asp-page="/Appointments/Create" class="btn btn-neon fw-bold w-100">📅 SCHEDULE</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- DIVIDER -->
        <div class="divider-gradient"></div>

        <!-- BMI CALCULATORS -->
        <h3 class="section-title">🧮 BMI CALCULATORS</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="card stat-card card-neon-yellow border-0 text-white h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-4 text-center">👨 ADULT BMI</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="form-label text-white fw-bold">Weight (kg)</label>
                                <input type="number" id="adultWeight" class="form-control fw-bold" placeholder="70" step="0.1">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-white fw-bold">Height (cm)</label>
                                <input type="number" id="adultHeight" class="form-control fw-bold" placeholder="175" step="0.1">
                            </div>
                        </div>
                        <button onclick="calcAdultBMI()" class="btn btn-neon fw-bold w-100 mb-3">📊 CALCULATE</button>
                        <div class="text-center p-3" style="background: rgba(255,255,255,0.15); border-radius: 15px;">
                            <div class="display-3 fw-bold text-white" id="adultResult">--</div>
                            <div class="badge badge-neon text-white mt-2" id="adultStatus">Enter values</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card stat-card card-neon-green border-0 text-white h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-4 text-center">👶 CHILD BMI</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="form-label text-white fw-bold">Weight (kg)</label>
                                <input type="number" id="cWeight" class="form-control fw-bold" placeholder="15" step="0.1">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-white fw-bold">Height (cm)</label>
                                <input type="number" id="cHeight" class="form-control fw-bold" placeholder="110" step="0.1">
                            </div>
                        </div>
                        <button onclick="calcChildBMI()" class="btn btn-neon fw-bold w-100 mb-3">📊 CALCULATE</button>
                        <div class="text-center p-3" style="background: rgba(255,255,255,0.15); border-radius: 15px;">
                            <div class="display-3 fw-bold text-white" id="pResult">--</div>
                            <div class="badge badge-neon text-white mt-2" id="pStatus">Enter values</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DIVIDER -->
        <div class="divider-gradient"></div>

        <!-- DOWNLOADS & RECORDS -->
        <h3 class="section-title">📥 YOUR FILES & RECORDS</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card stat-card card-neon-green border-0 text-white h-100">
                    <div class="card-body text-center">
                        <div class="icon-mega">📄</div>
                        <h6 class="card-title">BILLING</h6>
                        <p class="card-text small mb-3">Invoices & receipts</p>
                        <a asp-page="/Billing/Index" class="btn btn-neon btn-sm w-100">VIEW</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card card-neon-purple border-0 text-white h-100">
                    <div class="card-body text-center">
                        <div class="icon-mega">🏥</div>
                        <h6 class="card-title">HISTORY</h6>
                        <p class="card-text small mb-3">Health records</p>
                        <a asp-page="/HealthRecords/Index" class="btn btn-neon btn-sm w-100">VIEW</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card card-neon-blue border-0 text-white h-100">
                    <div class="card-body text-center">
                        <div class="icon-mega">🧬</div>
                        <h6 class="card-title">LAB TESTS</h6>
                        <p class="card-text small mb-3">Test reports</p>
                        <a asp-page="/Labs/Index" class="btn btn-neon btn-sm w-100">VIEW</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card card-neon-pink border-0 text-white h-100">
                    <div class="card-body text-center">
                        <div class="icon-mega">📋</div>
                        <h6 class="card-title">SUMMARIES</h6>
                        <p class="card-text small mb-3">Discharge docs</p>
                        <a asp-page="/DischargeSummaries/Index" class="btn btn-neon btn-sm w-100">VIEW</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- DIVIDER -->
        <div class="divider-gradient"></div>

        <!-- DIVIDER -->
        <div class="divider-gradient"></div>

        <!-- FAST BOOKING SECTION -->
        <h3 class="section-title">⚡ FAST BOOKING - BOOK IN SECONDS</h3>
        <div class="card stat-card border-0 text-white p-5 mb-5" style="background: linear-gradient(135deg, #ff006e 0%, #ff3385 25%, #ff66cc 50%, #ff0080 75%, #ff1493 100%); animation: glowPulse 3s ease-in-out infinite, gradientShift 8s ease infinite; background-size: 300% 300%;">
            <div class="alert alert-light text-dark mb-4 fw-bold text-center" style="font-size: 1.2rem; border-radius: 20px; border: 3px solid rgba(255,255,255,0.5);">
                🚀 INSTANT BOOKING - No waiting, no hassles! Get your appointment in seconds! 
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-5 rounded-4 border-3 text-center" style="background: linear-gradient(135deg, #00bfff 0%, #00d4ff 50%, #1e90ff 100%); border: 4px solid rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s ease; box-shadow: 0 10px 40px rgba(0,0,0,0.3);" onmouseover="this.style.transform='translateY(-15px) scale(1.05)'; this.style.boxShadow='0 25px 70px rgba(0,0,0,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 10px 40px rgba(0,0,0,0.3)';">
                        <h3 style="font-size: 4rem; margin: 1rem 0;">🎥</h3>
                        <h5 class="fw-bold text-white mb-2" style="font-size: 1.5rem;">VIDEO CONSULTATION</h5>
                        <p class="text-white fw-bold mb-4" style="font-size: 1.1rem;">Connect with doctors instantly from home</p>
                        <div style="display: inline-block; background: rgba(255,255,255,0.2); padding: 1rem 2rem; border-radius: 15px; margin-bottom: 1rem;">
                            <p class="text-white mb-0" style="font-size: 0.9rem;">✓ <strong>Available 24/7</strong><br>✓ <strong>5-min response</strong><br>✓ <strong>Secure & private</strong></p>
                        </div>
                        <button class="btn btn-neon w-100 fw-bold btn-lg" onclick="checkPaymentAndBook('telehealth')">BOOK TELEHEALTH NOW →</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-5 rounded-4 border-3 text-center" style="background: linear-gradient(135deg, #ff6b35 0%, #ff8c00 50%, #ffa500 100%); border: 4px solid rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s ease; box-shadow: 0 10px 40px rgba(0,0,0,0.3);" onmouseover="this.style.transform='translateY(-15px) scale(1.05)'; this.style.boxShadow='0 25px 70px rgba(0,0,0,0.5)';" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 10px 40px rgba(0,0,0,0.3)';">
                        <h3 style="font-size: 4rem; margin: 1rem 0;">🏥</h3>
                        <h5 class="fw-bold text-white mb-2" style="font-size: 1.5rem;">IN-PERSON VISIT</h5>
                        <p class="text-white fw-bold mb-4" style="font-size: 1.1rem;">Visit our modern facility with zero wait</p>
                        <div style="display: inline-block; background: rgba(255,255,255,0.2); padding: 1rem 2rem; border-radius: 15px; margin-bottom: 1rem;">
                            <p class="text-white mb-0" style="font-size: 0.9rem;">✓ <strong>State-of-the-art</strong><br>✓ <strong>Priority seating</strong><br>✓ <strong>Expert doctors</strong></p>
                        </div>
                        <button class="btn btn-neon w-100 fw-bold btn-lg" onclick="checkPaymentAndBook('inperson')">BOOK CLINIC VISIT →</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- DIVIDER -->
        <div class="divider-gradient"></div>

        <!-- SECURE ACCESS SECTION -->
        <h3 class="section-title">🔒 SECURE ACCESS - YOUR PRIVACY MATTERS</h3>
        <div class="card stat-card border-0 text-white p-5 mb-5" style="background: linear-gradient(135deg, #00ff88 0%, #20ff8c 25%, #06ffa5 50%, #00ff99 75%, #1dda63 100%); animation: glowPulse 3s ease-in-out infinite, gradientShift 8s ease infinite; background-size: 300% 300%;">
            <div class="alert alert-light text-dark mb-4 fw-bold text-center" style="font-size: 1.2rem; border-radius: 20px; border: 3px solid rgba(255,255,255,0.5);">
