@page
@model HospitalWebApp.Areas.Identity.Pages.DashboardModel
@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="dashboard-shell patient-dashboard">
    <div class="container">
        <div class="patient-hero">
            <div class="dashboard-kicker text-white-75">Personal care center</div>
            <h1>Good to see you, @Model.FullName</h1>
            <p>Review your care, keep track of appointments and billing, and access records securely in one place.</p>
            <a asp-area="" asp-page="/Appointments/Create" class="btn btn-light mt-2">
                <i class="bi bi-calendar-plus me-2"></i>Book an appointment
            </a>
        </div>

        <div class="metric-grid">
            <div class="metric-card">
                <div class="metric-card-head">
                    <span class="metric-icon" style="background:#edf7f5;color:#367d75"><i class="bi bi-heart-pulse"></i></span>
                    <span class="status-pill success">@Model.BMICategory</span>
                </div>
                <div class="metric-value">@(Model.BMI > 0 ? Model.BMI.ToString("F1") : "--")</div>
                <div class="metric-label">Current BMI</div>
            </div>
            <div class="metric-card">
                <div class="metric-card-head"><span class="metric-icon" style="background:#fff4e8;color:#a66b24"><i class="bi bi-credit-card"></i></span></div>
                <div class="metric-value">KSh @Model.PaidAmount.ToString("N2")</div>
                <div class="metric-label">Payments recorded</div>
            </div>
            <div class="metric-card">
                <div class="metric-card-head"><span class="metric-icon" style="background:#eef4ff;color:#315d9b"><i class="bi bi-calendar2-check"></i></span></div>
                <div class="metric-value">KSh @((Model.TotalAmount - Model.PaidAmount).ToString("N2"))</div>
                <div class="metric-label">Outstanding balance</div>
            </div>
            <div class="metric-card">
                <div class="metric-card-head"><span class="metric-icon" style="background:#f5efff;color:#7557a1"><i class="bi bi-shield-check"></i></span></div>
                <div class="metric-value">@Model.CyclePhase</div>
                <div class="metric-label">Wellness tracker</div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div>
                <div class="dashboard-panel">
                    <div class="dashboard-panel-header">
                        <h2>Care services</h2>
                        <span class="status-pill">Patient access</span>
                    </div>
                    <div class="dashboard-panel-body">
                        <div class="patient-quick-grid">
                            <a asp-area="" asp-page="/Appointments/Create" class="patient-quick-link">
                                <i class="bi bi-calendar2-plus"></i>
                                <div><strong>Book care</strong><br><small class="text-muted">Schedule a visit</small></div>
                            </a>
                            <a asp-area="" asp-page="/Appointments/Index" class="patient-quick-link">
                                <i class="bi bi-calendar2-week"></i>
                                <div><strong>Appointments</strong><br><small class="text-muted">View and manage visits</small></div>
                            </a>
                            <a asp-area="" asp-page="/HealthRecords/Index" class="patient-quick-link">
                                <i class="bi bi-file-medical"></i>
                                <div><strong>Health records</strong><br><small class="text-muted">History and diagnoses</small></div>
                            </a>
                            <a asp-area="" asp-page="/Labs/Index" class="patient-quick-link">
                                <i class="bi bi-droplet"></i>
                                <div><strong>Lab results</strong><br><small class="text-muted">Reports and status</small></div>
                            </a>
                            <a asp-area="" asp-page="/Billing/Index" class="patient-quick-link">
                                <i class="bi bi-receipt"></i>
                                <div><strong>Billing</strong><br><small class="text-muted">Invoices and payments</small></div>
                            </a>
                            <a asp-area="" asp-page="/DischargeSummaries/Index" class="patient-quick-link">
                                <i class="bi bi-journal-medical"></i>
                                <div><strong>Discharge summaries</strong><br><small class="text-muted">Care instructions</small></div>
                            </a>
                            <a asp-area="" asp-page="/Pharmacy/Index" class="patient-quick-link">
                                <i class="bi bi-capsule"></i>
                                <div><strong>Hospital pharmacy</strong><br><small class="text-muted">Browse and request items</small></div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <aside>
                <div class="patient-summary-card mb-3">
                    <h2><i class="bi bi-bell me-2 text-primary"></i>Care reminders</h2>
                    <hr>
                    <p class="mb-2"><strong>Billing</strong></p>
                    @if (Model.HasPaidInvoices)
                    {
                        <p class="text-muted small">Your account has recorded payments. Review outstanding charges in Billing.</p>
                    }
                    else
                    {
                        <p class="text-muted small">No payment has been recorded. Check Billing for current charges.</p>
                    }
                </div>
                <div class="patient-summary-card">
                    <h2><i class="bi bi-chat-heart me-2 text-primary"></i>Need support?</h2>
                    <p class="text-muted small mt-3">For urgent symptoms, contact the hospital or emergency services directly. Do not wait for a dashboard notification.</p>
                    <a href="tel:+254110361550" class="btn btn-outline-primary w-100">Call the hospital</a>
                </div>
            </aside>
        </div>
    </div>
</div>
