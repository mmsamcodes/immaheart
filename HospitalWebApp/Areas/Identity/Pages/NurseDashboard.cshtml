@page
@model HospitalWebApp.Areas.Identity.Pages.NurseDashboardModel
@{ ViewData["Title"] = "Nursing Dashboard"; }
<div class="dashboard-shell">
 <div class="container">
  <div class="dashboard-header"><div><div class="dashboard-kicker">Inpatient and clinical support</div><h1>Good to see you, @Model.FullName</h1><p>Coordinate admissions and move patients safely through care queues.</p></div><a asp-area="" asp-page="/Admissions/Index" class="btn btn-primary"><i class="bi bi-hospital me-2"></i>Review admissions</a></div>
  <div class="metric-grid">
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-hospital"></i></span></div><div class="metric-value">@Model.PendingAdmissions</div><div class="metric-label">Active admissions</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-person-check"></i></span></div><div class="metric-value">@Model.DoctorQueueCount</div><div class="metric-label">Doctor queue</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-droplet"></i></span></div><div class="metric-value">@Model.LabQueueCount</div><div class="metric-label">Lab queue</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-capsule"></i></span></div><div class="metric-value">@Model.PharmacyQueueCount</div><div class="metric-label">Pharmacy queue</div></div>
  </div>
  <div class="row g-3">
   <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Admissions/Index" class="provider-action-card"><i class="bi bi-hospital"></i><h5>Admissions</h5><p class="text-muted small mb-0">Ward assignments and admission status</p></a></div>
   <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Doctor" class="provider-action-card"><i class="bi bi-person-lines-fill"></i><h5>Doctor queue</h5><p class="text-muted small mb-0">Prepare patients for assessment</p></a></div>
   <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Lab" class="provider-action-card"><i class="bi bi-droplet"></i><h5>Laboratory queue</h5><p class="text-muted small mb-0">Track specimens and pending tests</p></a></div>
   <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Pharmacy" class="provider-action-card"><i class="bi bi-capsule"></i><h5>Pharmacy queue</h5><p class="text-muted small mb-0">Coordinate medication collection</p></a></div>
  </div>
 </div>
</div>
