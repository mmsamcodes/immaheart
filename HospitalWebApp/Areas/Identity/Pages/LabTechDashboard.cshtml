@page
@model HospitalWebApp.Areas.Identity.Pages.LabTechDashboardModel
@{ ViewData["Title"] = "Laboratory Dashboard"; }
<div class="dashboard-shell">
 <div class="container">
  <div class="dashboard-header"><div><div class="dashboard-kicker">Diagnostics workspace</div><h1>Laboratory operations</h1><p>Welcome back, @Model.FullName. Prioritize active orders and validate result delivery.</p></div><a asp-area="" asp-page="/Labs/Index" class="btn btn-primary"><i class="bi bi-clipboard2-pulse me-2"></i>Open all orders</a></div>
  <div class="metric-grid">
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span><span class="status-pill warning">Action required</span></div><div class="metric-value">@Model.PendingLabOrders</div><div class="metric-label">Pending orders</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><div class="metric-value">@Model.CompletedLabOrders</div><div class="metric-label">Completed orders</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-person-lines-fill"></i></span></div><div class="metric-value">@Model.LabQueueCount</div><div class="metric-label">Patients in lab queue</div></div>
  </div>
  <div class="dashboard-grid">
   <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Laboratory worklist</h2></div><div class="dashboard-panel-body"><p>Record specimen collection, publish verified results and complete the diagnostic service charge automatically.</p><a asp-area="" asp-page="/Labs/Index" class="btn btn-primary">Review lab orders</a></div></div>
   <aside><div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Safety checklist</h2></div><div class="dashboard-panel-body"><p class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Confirm patient identity</p><p class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Verify specimen labeling</p><p class="mb-0"><i class="bi bi-check2 text-success me-2"></i>Upload final reports only</p></div></div></aside>
  </div>
 </div>
</div>
