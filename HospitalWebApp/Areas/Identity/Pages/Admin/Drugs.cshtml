@page
@model HospitalWebApp.Areas.Identity.Pages.Admin.DrugsModel
@{
    ViewData["Title"] = "Drug Catalog";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Drug Catalog</h1>
            <p class="text-muted">Manage the patient-facing pharmacy catalog, stock and prescription requirements.</p>
        </div>
        @if (User.IsInRole("Pharmacy"))
        {
            <a asp-area="Identity" asp-page="/PharmacyDashboard" class="btn btn-secondary">Back to pharmacy</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/AdminDashboard" class="btn btn-secondary">Back to dashboard</a>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="InputDrug.Name" class="form-label">Name</label>
                        <input asp-for="InputDrug.Name" class="form-control" />
                        <span asp-validation-for="InputDrug.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputDrug.Code" class="form-label">Code</label>
                        <input asp-for="InputDrug.Code" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputDrug.UnitPrice" class="form-label">Price</label>
                        <input asp-for="InputDrug.UnitPrice" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputDrug.StockQuantity" class="form-label">Stock</label>
                        <input asp-for="InputDrug.StockQuantity" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputDrug.Unit" class="form-label">Unit</label>
                        <input asp-for="InputDrug.Unit" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InputDrug.Category" class="form-label">Category</label>
                        <input asp-for="InputDrug.Category" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="InputDrug.Description" class="form-label">Description</label>
                        <input asp-for="InputDrug.Description" class="form-control" />
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-3">
                    <div class="form-check">
                        <input asp-for="InputDrug.RequiresPrescription" class="form-check-input" />
                        <label asp-for="InputDrug.RequiresPrescription" class="form-check-label">Prescription required</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="InputDrug.IsActive" class="form-check-input" />
                        <label asp-for="InputDrug.IsActive" class="form-check-label">Available in patient catalog</label>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add drug</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success mt-3">@Model.Message</div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5>Existing drugs</h5>
            @if (!Model.Drugs.Any())
            {
                <div class="alert alert-secondary">No drugs have been added yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Price</th>
                                <th>Unit</th>
                                <th>Stock</th>
                                <th>Category</th>
                                <th>Prescription</th>
                                <th>Catalog</th>
                                <th>Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var drug in Model.Drugs)
                            {
                                <tr>
                                    <td>@drug.Name</td>
                                    <td>@drug.Code</td>
                                    <td>KSh @drug.UnitPrice.ToString("N2")</td>
                                    <td>@drug.Unit</td>
                                    <td>@drug.StockQuantity</td>
                                    <td>@drug.Category</td>
                                    <td>@(drug.RequiresPrescription ? "Required" : "Not required")</td>
                                    <td>@(drug.IsActive ? "Available" : "Hidden")</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editDrug-@drug.Id">Edit</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @foreach (var drug in Model.Drugs)
                {
                    <div class="modal fade" id="editDrug-@drug.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="Update">
                                    <div class="modal-header"><h2 class="modal-title fs-5">Update @drug.Name</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                                    <div class="modal-body">
                                        <input type="hidden" name="id" value="@drug.Id" />
                                        <input type="hidden" name="InputDrug.Id" value="@drug.Id" />
                                        <div class="row g-3">
                                            <div class="col-md-6"><label for="drug-name-@drug.Id" class="form-label">Name</label><input id="drug-name-@drug.Id" name="InputDrug.Name" value="@drug.Name" class="form-control" required /></div>
                                            <div class="col-md-6"><label for="drug-code-@drug.Id" class="form-label">Code</label><input id="drug-code-@drug.Id" name="InputDrug.Code" value="@drug.Code" class="form-control" /></div>
                                            <div class="col-md-4"><label for="drug-price-@drug.Id" class="form-label">Unit price (KSh)</label><input id="drug-price-@drug.Id" name="InputDrug.UnitPrice" type="number" value="@drug.UnitPrice" class="form-control" min="0" max="10000000" step="0.01" /></div>
                                            <div class="col-md-4"><label for="drug-stock-@drug.Id" class="form-label">Stock quantity</label><input id="drug-stock-@drug.Id" name="InputDrug.StockQuantity" type="number" value="@drug.StockQuantity" class="form-control" min="0" step="1" /></div>
                                            <div class="col-md-4"><label for="drug-unit-@drug.Id" class="form-label">Unit</label><input id="drug-unit-@drug.Id" name="InputDrug.Unit" value="@drug.Unit" class="form-control" /></div>
                                            <div class="col-md-5"><label for="drug-category-@drug.Id" class="form-label">Category</label><input id="drug-category-@drug.Id" name="InputDrug.Category" value="@drug.Category" class="form-control" /></div>
                                            <div class="col-md-7"><label for="drug-description-@drug.Id" class="form-label">Description</label><input id="drug-description-@drug.Id" name="InputDrug.Description" value="@drug.Description" class="form-control" /></div>
                                        </div>
                                        <div class="d-flex flex-wrap gap-4 mt-3">
                                            <div class="form-check"><input id="drug-rx-@drug.Id" name="InputDrug.RequiresPrescription" type="checkbox" value="true" checked="@(drug.RequiresPrescription ? "checked" : null)" class="form-check-input" /><input name="InputDrug.RequiresPrescription" type="hidden" value="false" /><label for="drug-rx-@drug.Id" class="form-check-label">Prescription required</label></div>
                                            <div class="form-check"><input id="drug-active-@drug.Id" name="InputDrug.IsActive" type="checkbox" value="true" checked="@(drug.IsActive ? "checked" : null)" class="form-check-input" /><input name="InputDrug.IsActive" type="hidden" value="false" /><label for="drug-active-@drug.Id" class="form-check-label">Available in patient catalog</label></div>
                                        </div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
