@page
@model HospitalWebApp.Areas.Identity.Pages.Admin.ServicesModel
@{
    ViewData["Title"] = "Service Catalog";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Service Catalog</h1>
            <p class="text-muted">Add and manage services for billing.</p>
        </div>
        <a asp-area="Identity" asp-page="/Admin/AdminDashboard" class="btn btn-secondary">Back to dashboard</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="InputService.Name" class="form-label">Name</label>
                        <input asp-for="InputService.Name" class="form-control" />
                        <span asp-validation-for="InputService.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputService.Code" class="form-label">Code</label>
                        <input asp-for="InputService.Code" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InputService.Price" class="form-label">Price</label>
                        <input asp-for="InputService.Price" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InputService.Category" class="form-label">Category</label>
                        <input asp-for="InputService.Category" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InputService.Description" class="form-label">Description</label>
                        <input asp-for="InputService.Description" class="form-control" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add service</button>
                    <button type="reset" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success mt-3">@Model.Message</div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5>Existing services</h5>
            @if (!Model.Services.Any())
            {
                <div class="alert alert-secondary">No services have been added yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th>Available</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in Model.Services)
                            {
                                <tr>
                                    <td>@service.Name</td>
                                    <td>@service.Code</td>
                                    <td>@service.Price.ToString("C")</td>
                                    <td>@service.Category</td>
                                    <td>@(service.IsAvailable ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
