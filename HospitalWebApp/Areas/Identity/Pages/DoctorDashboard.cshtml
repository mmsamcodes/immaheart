@page
@model HospitalWebApp.Areas.Identity.Pages.DoctorDashboardModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}
<div class="dashboard-shell">
    <div class="container">
        <div class="dashboard-header"><div><div class="dashboard-kicker">Clinical workspace</div><h1>Good morning, Dr. @Model.FullName</h1><p>Review today's workload, patient queues and clinical records.</p></div><a asp-area="" asp-page="/Appointments/Index" class="btn btn-primary"><i class="bi bi-calendar-week me-2"></i>View schedule</a></div>
        <div class="metric-grid">
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-calendar2-check"></i></span><span class="status-pill">Today</span></div><div class="metric-value">@Model.TodayAppointmentsCount</div><div class="metric-label">Appointments</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-people"></i></span></div><div class="metric-value">@Model.TotalPatientsCount</div><div class="metric-label">Unique patients</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><div class="metric-value">@Model.PendingAppointmentsCount</div><div class="metric-label">Pending actions</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-person-lines-fill"></i></span></div><div class="metric-value">@Model.QueuedPatientsCount</div><div class="metric-label">In doctor queue</div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Queue/Index" asp-route-queueType="Doctor" class="provider-action-card"><i class="bi bi-person-check"></i><h5>Patient queue</h5><p class="text-muted small mb-0">Call and assess waiting patients</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/HealthRecords/Index" class="provider-action-card"><i class="bi bi-file-medical"></i><h5>Health records</h5><p class="text-muted small mb-0">Review history and documentation</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Labs/Index" class="provider-action-card"><i class="bi bi-droplet"></i><h5>Lab orders</h5><p class="text-muted small mb-0">Order tests and review results</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Video/Sessions" class="provider-action-card"><i class="bi bi-camera-video"></i><h5>Telehealth</h5><p class="text-muted small mb-0">@Model.VirtualAppointmentsCount virtual appointments</p></a></div>
        </div>
        <div class="dashboard-grid">
            <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Upcoming appointments</h2><a asp-area="" asp-page="/Appointments/Index" class="btn btn-sm btn-outline-primary">Full schedule</a></div><div class="table-responsive"><table class="dashboard-table"><thead><tr><th>Time</th><th>Patient</th><th>Visit</th><th>Status</th></tr></thead><tbody>@if (Model.UpcomingAppointments.Any()){foreach(var appt in Model.UpcomingAppointments.Take(8)){<tr><td>@appt.AppointmentDate.ToString("MMM dd, HH:mm")</td><td><strong>@appt.Patient?.FullName</strong></td><td>@(appt.IsVirtual ? "Virtual" : "In-person")</td><td><span class="status-pill">@appt.Status</span></td></tr>}}else{<tr><td colspan="4" class="text-muted">No upcoming appointments.</td></tr>}</tbody></table></div></div>
            <aside><div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Doctor queue</h2></div><div class="table-responsive"><table class="dashboard-table"><thead><tr><th>Patient</th><th>Queue</th></tr></thead><tbody>@foreach (var item in Model.DoctorQueueEntries.Take(8)){<tr><td>@item.Patient?.FullName</td><td><span class="status-pill warning">@item.Status</span></td></tr>}</tbody></table></div></div></aside>
        </div>
    </div>
</div>
