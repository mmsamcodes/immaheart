@page
@model HospitalWebApp.Areas.Identity.Pages.DoctorDashboardModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">Welcome back, Dr. <span class="text-primary">@Model.FullName</span></h2>
            <p class="text-muted">Immaculate Heart Hospital - Manage Your Patients</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-center">
                    <h5 class="mb-4">Today's Appointments</h5>
                    <div class="display-3 fw-bold">@Model.TodayAppointmentsCount</div>
                    <p class="small mt-3">Scheduled for today</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="border-top: 5px solid #28a745;">
                <div class="card-body">
                    <h5 class="text-success"><i class="bi bi-people"></i> Total Patients</h5>
                    <div class="text-center py-3">
                        <div class="display-4 fw-bold text-success">@Model.TotalPatientsCount</div>
                    </div>
                    <p class="small text-muted">Patients under your care</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-warning text-white">
                <div class="card-body text-center">
                    <h5><i class="bi bi-clock"></i> Pending Appointments</h5>
                    <div class="display-4 fw-bold">@Model.PendingAppointmentsCount</div>
                    <p class="small">Awaiting confirmation</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-primary"><i class="bi bi-list-check"></i> Doctor Queue</h5>
                    <div class="display-4 fw-bold">@Model.QueuedPatientsCount</div>
                    <p class="small mt-3">Patients waiting in the doctor queue</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-info"><i class="bi bi-camera-video"></i> Telemedicine</h5>
                    <div class="display-4 fw-bold">@Model.VirtualAppointmentsCount</div>
                    <p class="small mt-3">Paid virtual sessions ready to review</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-success"><i class="bi bi-person-square"></i> In-Person Visits</h5>
                    <div class="display-4 fw-bold">@Model.InPersonAppointmentsCount</div>
                    <p class="small mt-3">Confirmed clinic visits</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="fw-bold">Lab Orders</h5>
                    <p class="text-muted">Review tests ordered, upload results, and share reports.</p>
                    <a asp-page="/Labs/Index" class="btn btn-primary">Open Labs</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="fw-bold">Virtual Appointments</h5>
                    <p class="text-muted">Manage video call sessions and confirm patient consultations.</p>
                    <a asp-page="/Video/Sessions" class="btn btn-primary">Open Video Sessions</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="fw-bold">Health Records</h5>
                    <p class="text-muted">Access and update patient medical history and notes.</p>
                    <a asp-page="/HealthRecords/Index" class="btn btn-primary">Open Records</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg bg-primary text-white">
                <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="fw-bold mb-2">Telehealth sessions are ready for your review.</h5>
                        <p class="mb-0 text-white-75">Create, confirm and join virtual appointments for paid patients with one click.</p>
                    </div>
                    <div class="text-md-end">
                        <a asp-page="/Video/Sessions" class="btn btn-warning btn-lg text-dark fw-bold">Open Video Sessions</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Upcoming Appointments</h5>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var appt in Model.UpcomingAppointments.Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @appt.Patient?.FullName - @appt.AppointmentDate.ToShortDateString()
                                    <span class="badge bg-primary rounded-pill">@appt.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No upcoming appointments.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill"></i> Recent Patients</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentPatients.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var patient in Model.RecentPatients.Take(5))
                            {
                                <li class="list-group-item">
                                    <strong>@patient.FullName</strong><br>
                                    <small class="text-muted">ID: @patient.IDNumber</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No recent patients.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-people-fill"></i> Doctor Queue</h5>
                </div>
                <div class="card-body">
                    @if (Model.DoctorQueueEntries.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Assigned By</th>
                                    <th>Queue</th>
                                    <th>Room</th>
                                    <th>Added</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var queueEntry in Model.DoctorQueueEntries.Take(8))
                                {
                                    <tr>
                                        <td>@queueEntry.Patient?.FullName</td>
                                        <td>@queueEntry.AssignedBy?.FullName</td>
                                        <td>@queueEntry.QueueType</td>
                                        <td>@queueEntry.Room</td>
                                        <td>@queueEntry.CreatedAt.ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No patients are currently queued for doctor review.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>