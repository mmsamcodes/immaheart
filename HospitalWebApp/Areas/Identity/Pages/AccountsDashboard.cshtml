@page
@model HospitalWebApp.Areas.Identity.Pages.AccountsDashboardModel
@{
    ViewData["Title"] = "Accounts";
    var unpaid = Model.Invoices.Count(i => i.Status != "Paid");
    var paid = Model.Invoices.Count(i => i.Status == "Paid");
    var balance = Model.Invoices.Sum(i => i.TotalAmount - i.PaidAmount);
}
<div class="dashboard-shell">
 <div class="container">
  <div class="dashboard-header"><div><div class="dashboard-kicker">Finance and cashier operations</div><h1>Accounts desk</h1><p>Reconcile invoices, record payments and maintain a clear audit trail.</p></div><a asp-area="" asp-page="/Billing/Index" class="btn btn-primary"><i class="bi bi-receipt me-2"></i>Billing records</a></div>
  @if (!string.IsNullOrEmpty(Model.Message)){<div class="alert alert-success">@Model.Message</div>}
  <div class="metric-grid">
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-receipt"></i></span></div><div class="metric-value">@Model.Invoices.Count</div><div class="metric-label">Total invoices</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><div class="metric-value">@paid</div><div class="metric-label">Paid invoices</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span><span class="status-pill warning">Action</span></div><div class="metric-value">@unpaid</div><div class="metric-label">Unpaid or partial</div></div>
   <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-cash-stack"></i></span></div><div class="metric-value">KSh @balance.ToString("N0")</div><div class="metric-label">Outstanding balance</div></div>
  </div>
  <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Invoice register</h2><a asp-area="" asp-page="/Billing/Index" class="btn btn-sm btn-outline-primary">Detailed billing</a></div><div class="table-responsive"><table class="dashboard-table"><thead><tr><th>Invoice</th><th>Patient</th><th>Issued</th><th>Total</th><th>Paid</th><th>Status</th><th></th></tr></thead><tbody>@if (Model.Invoices.Any()){foreach(var inv in Model.Invoices){<tr><td><strong>@inv.InvoiceNumber</strong></td><td>@inv.Patient?.FullName</td><td>@inv.IssuedAt.ToString("MMM dd, yyyy")</td><td>KSh @inv.TotalAmount.ToString("N0")</td><td>KSh @inv.PaidAmount.ToString("N0")</td><td><span class="status-pill @(inv.Status=="Paid"?"success":inv.Status=="Partial"?"warning":"danger")">@inv.Status</span></td><td><button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#payModal" data-invoiceid="@inv.Id" data-total="@inv.TotalAmount" data-paid="@inv.PaidAmount">Log payment</button></td></tr>}}else{<tr><td colspan="7" class="text-muted">No invoices found.</td></tr>}</tbody></table></div></div>
 </div>
</div>
<div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="MarkPaid"><div class="modal-header"><h5 class="modal-title">Log payment</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" id="InvoiceId" name="InvoiceId"><div class="mb-3"><label class="form-label">Amount</label><input type="number" step="0.01" class="form-control" id="Amount" name="Amount" required></div><div class="mb-3"><label class="form-label">Method</label><select class="form-select" id="Method" name="Method"><option>MPesa</option><option>Visa</option><option>Cash</option></select></div><div class="mb-3"><label class="form-label">Reference</label><input type="text" class="form-control" id="Reference" name="Reference"></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save payment</button></div></form></div></div></div>
@section Scripts {
<script>
document.getElementById('payModal').addEventListener('show.bs.modal', function(event){
 const button=event.relatedTarget;
 const total=parseFloat(button.dataset.total||0);
 const paid=parseFloat(button.dataset.paid||0);
 this.querySelector('#InvoiceId').value=button.dataset.invoiceid;
 this.querySelector('#Amount').value=Math.max(total-paid,0).toFixed(2);
});
</script>
}
