@page
@model HospitalWebApp.Areas.Identity.Pages.AddServiceModel
@{
    ViewData["Title"] = "Clinical Service Orders";
}

<div class="dashboard-shell">
    <div class="container">
        <div class="dashboard-header">
            <div>
                <div class="dashboard-kicker">Clinical operations</div>
                <h1>Clinical service orders</h1>
                <p>Assign a catalog service to a checked-in patient and record completion when it has been delivered.</p>
            </div>
            <a asp-area="" asp-page="/PatientTracking/Index" class="btn btn-outline-primary"><i class="bi bi-diagram-3 me-2"></i>Patient flow</a>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="status">@Model.Message</div>
        }
        @if (TempData["ServiceMessage"] is string serviceMessage)
        {
            <div class="alert alert-info" role="status">@serviceMessage</div>
        }

        <div class="row g-3">
            <div class="col-lg-5">
                <section class="dashboard-panel">
                    <div class="dashboard-panel-header"><h2>Assign a service</h2></div>
                    <div class="dashboard-panel-body">
                        <form method="post">
                            <div class="mb-3">
                                <label asp-for="PatientId" class="form-label">Patient</label>
                                <select asp-for="PatientId" class="form-select" required>
                                    <option value="">Choose a patient</option>
                                    @foreach (var patient in Model.Patients.OrderBy(item => item.FullName))
                                    {
                                        <option value="@patient.Id">@patient.FullName (@patient.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ServiceCatalogId" class="form-label">Clinical service</label>
                                <select asp-for="ServiceCatalogId" class="form-select" required>
                                    <option value="">Choose a service</option>
                                    @foreach (var category in Model.Services.GroupBy(service => service.Category))
                                    {
                                        <optgroup label="@category.Key">
                                            @foreach (var service in category)
                                            {
                                                <option value="@service.Id">@service.Name</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ScheduledDate" class="form-label">Scheduled time (optional)</label>
                                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">Clinical instruction (optional)</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
                            </div>
                            <p class="small text-muted">The assigned service price is recorded internally and added to the patient's invoice only when the service is marked complete.</p>
                            <button type="submit" class="btn btn-primary">Assign to active visit</button>
                        </form>
                    </div>
                </section>
            </div>

            <div class="col-lg-7">
                <section class="dashboard-panel">
                    <div class="dashboard-panel-header"><h2>Recent assignments</h2></div>
                    <div class="table-responsive">
                        <table class="dashboard-table">
                            <thead><tr><th>Patient</th><th>Service</th><th>Status</th><th>Assigned</th><th>Action</th></tr></thead>
                            <tbody>
                                @if (!Model.AssignedServices.Any())
                                {
                                    <tr><td colspan="5" class="text-muted">No services assigned by you yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.AssignedServices.Take(20))
                                    {
                                        <tr>
                                            <td>@item.Patient?.FullName</td>
                                            <td>
                                                <strong>@item.Service?.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <div class="small text-muted">@item.Notes</div>
                                                }
                                            </td>
                                            <td><span class="status-pill @(item.Status == "Completed" ? "success" : "warning")">@item.Status</span></td>
                                            <td>@item.AssignedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                            <td>
                                                @if (item.Status == "Pending")
                                                {
                                                    <form method="post" asp-page-handler="Complete">
                                                        <input type="hidden" name="patientServiceId" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-primary">Complete and charge</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
