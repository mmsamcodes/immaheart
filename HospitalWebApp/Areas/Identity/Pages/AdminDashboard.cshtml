@page
@model HospitalWebApp.Areas.Identity.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Administration";
}
<div class="dashboard-shell">
    <div class="container">
        <div class="dashboard-header">
            <div><div class="dashboard-kicker">Hospital administration</div><h1>Operations overview</h1><p>Monitor resources, staff, patient activity and financial exposure.</p></div>
            <a asp-area="Identity" asp-page="/Admin/ManageStaff" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Manage staff</a>
        </div>
        <div class="metric-grid">
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-people"></i></span><span class="status-pill">All users</span></div><div class="metric-value">@Model.TotalUsersCount</div><div class="metric-label">Registered users</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-person-heart"></i></span></div><div class="metric-value">@Model.PatientsCount</div><div class="metric-label">Patient accounts</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-hospital"></i></span></div><div class="metric-value">@Model.AdmissionsCount</div><div class="metric-label">Admissions</div></div>
            <div class="metric-card"><div class="metric-card-head"><span class="metric-icon"><i class="bi bi-exclamation-circle"></i></span></div><div class="metric-value">@Model.OutstandingInvoicesCount</div><div class="metric-label">Outstanding invoices</div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Admissions/Index" class="provider-action-card"><i class="bi bi-hospital"></i><h5>Admissions</h5><p class="text-muted small mb-0">Beds, wards and patient status</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="" asp-page="/Billing/Index" class="provider-action-card"><i class="bi bi-cash-stack"></i><h5>Billing</h5><p class="text-muted small mb-0">Invoices, balances and revenue</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="Identity" asp-page="/Admin/Drugs" class="provider-action-card"><i class="bi bi-capsule"></i><h5>Drug catalog</h5><p class="text-muted small mb-0">@Model.DrugCatalogCount catalog items</p></a></div>
            <div class="col-lg-3 col-md-6"><a asp-area="Identity" asp-page="/Admin/Services" class="provider-action-card"><i class="bi bi-briefcase-medical"></i><h5>Service catalog</h5><p class="text-muted small mb-0">@Model.ServiceCatalogCount configured services</p></a></div>
        </div>
        <div class="dashboard-grid">
            <div>
                <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Recent staff</h2><a asp-area="Identity" asp-page="/Admin/ManageStaff" class="btn btn-sm btn-outline-primary">View staff</a></div><div class="table-responsive"><table class="dashboard-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead><tbody>@foreach (var doctor in Model.RecentDoctors.Take(8)){<tr><td><strong>@doctor.FullName</strong></td><td>@doctor.Email</td><td><span class="status-pill success">Doctor</span></td></tr>}</tbody></table></div></div>
            </div>
            <aside>
                <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Financial summary</h2></div><div class="dashboard-panel-body"><div class="dashboard-kicker">Outstanding</div><h3>KSh @Model.OutstandingBalance.ToString("N0")</h3><p class="text-muted small">@Model.OutstandingInvoicesCount unpaid or partial invoices</p><a asp-area="Identity" asp-page="/AccountsDashboard" class="btn btn-primary w-100">Open accounts</a></div></div>
                <div class="dashboard-panel"><div class="dashboard-panel-header"><h2>Catalog health</h2></div><div class="dashboard-panel-body"><p class="mb-2"><strong>@Model.LabOrdersCount</strong> lab orders</p><p class="mb-2"><strong>@Model.TotalInvoicesCount</strong> invoices</p><p class="mb-0"><strong>@Model.DoctorsCount</strong> doctors</p></div></div>
            </aside>
        </div>
        @if (!string.IsNullOrEmpty(Model.Message)){<div class="alert alert-info mt-3">@Model.Message</div>}
    </div>
</div>
